@page
@* Restyles the built-in Identity login page. Only the view is ours; the library's LoginModel does the sign-in. *@
@using Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal
@model LoginModel
@{
    ViewData["Title"] = L["Log in"].Value;
    ViewData["Chrome"] = "auth"; // this page draws its own split-screen chrome
    var currentUrl = $"{Request.PathBase}{Request.Path}{Request.QueryString}";
}

<div class="auth-split">
    <partial name="_AuthPanel" />

    <div class="auth-form-side">
        <div class="auth-form-top">
            <partial name="_LanguageSwitch" model="currentUrl" />
            <partial name="_ThemeToggle" />
        </div>

        <div class="auth-form-wrap">
            <div class="auth-form-card">
                <h1>@L["Log in"]</h1>
                <p class="text-secondary mb-4">@L["Welcome back to your workshop."]</p>

                <form id="account" method="post" novalidate>
                    <partial name="_FormErrors" />

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">@L["Email"]</label>
                        <span asp-validation-for="Input.Email"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["Password"]" />
                        <label asp-for="Input.Password">@L["Password"]</label>
                        <span asp-validation-for="Input.Password"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">@L["Keep me signed in"]</label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">@L["Log in"]</button>
                </form>

                <p class="text-center text-secondary mt-4 mb-0">
                    @L["New here?"] <a class="fw-bold" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@L["Create your shop"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
