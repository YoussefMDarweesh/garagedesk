@* Page title on the start side (with its section above it); search and the reminders bell, then one small
   preferences pill (language and theme) and the user menu on the other side. The long email lives in the menu, not on the bar. *@
@model GarageDesk.Web.Services.ShellModel
@using GarageDesk.Web.Services
@{
    var logoView = Model.LogoVersion is null
        ? null
        : new ShopLogoView(Url.Content("~" + ShopLogoEndpoint.Path) + "?v=" + Model.LogoVersion, Model.ShopName ?? "", "sm");
    var who = !string.IsNullOrWhiteSpace(Model.DisplayName) ? Model.DisplayName! : Model.UserName ?? "";
    var initial = string.IsNullOrEmpty(who) ? "?" : char.ToUpperInvariant(who[0]).ToString();
    var roleLabel = Model.Role switch
    {
        GarageDesk.Web.Models.ShopRole.Owner => L["Owner"].Value,
        GarageDesk.Web.Models.ShopRole.Cashier => L["Cashier"].Value,
        _ => L["Technician"].Value,
    };
}
<header class="topbar">
    @* brand-logo: on a phone there is no rail, so the shop (its logo, or the GarageDesk mark) sits at the start of the bar. *@
    <a class="topbar-brand" asp-area="" asp-page="/Index" aria-label="@(Model.ShopName ?? "GarageDesk")">
        @if (logoView is not null)
        {
            <partial name="_ShopLogo" model="logoView" />
        }
        else
        {
            <span class="topbar-mark"><partial name="_BrandMark" model='"tile"' /></span>
        }
    </a>
    <div class="topbar-heading">
        @if (!string.IsNullOrEmpty(Model.GroupLabel))
        {
            <p class="topbar-crumb">@Model.GroupLabel</p>
        }
        <p class="topbar-title">@Model.Section</p>
    </div>
    <span class="topbar-spacer"></span>

    @* Customer search and reminders are for owners and cashiers: a technician must never reach phone numbers. *@
    @if (Model.Role != GarageDesk.Web.Models.ShopRole.Technician)
    {
        <form class="topbar-search" asp-area="" asp-page="/Customers/Index" method="get" role="search">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" placeholder="@L["Search customers, phones, plates"]" aria-label="@L["Search customers, phones, plates"]" autocomplete="off" />
        </form>

        <a class="icon-btn" asp-area="" asp-page="/Reminders/Index" title="@L["Reminders"]" aria-label="@L["Reminders"]">
            <partial name="_Icon" model='"bell"' />
            @if (Model.DueCount > 0)
            {
                <span class="count num">@(Model.DueCount > 99 ? "99+" : Model.DueCount.ToString())</span>
            }
        </a>
    }

    <div class="topbar-prefs desktop-only">
        <partial name="_LanguageSwitch" model="Model.ReturnUrl" />
        <partial name="_ThemeToggle" />
    </div>

    <div class="dropdown">
        <button class="user-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["Account menu"]">
            <span class="avatar avatar-sm">@initial</span>
            <span class="user-meta desktop-only">
                <span class="user-name">@who</span>
                <span class="user-role">@roleLabel</span>
            </span>
            <span class="desktop-only user-caret"><partial name="_Icon" model='"chevron-down"' /></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text small text-secondary">@L["Signed in as"]<br /><strong class="text-body">@Model.UserName</strong><br /><span class="chip chip-accent mt-1">@roleLabel</span></span></li>
            <li><hr class="dropdown-divider" /></li>
            @if (Model.Role == GarageDesk.Web.Models.ShopRole.Owner)
            {
                <li><a class="dropdown-item" asp-area="" asp-page="/ShopSettings"><partial name="_Icon" model='"sliders"' />@L["Shop settings"]</a></li>
                <li><a class="dropdown-item" asp-area="" asp-page="/Staff/Index"><partial name="_Icon" model='"users"' />@L["My team"]</a></li>
                <li><a class="dropdown-item" asp-area="" asp-page="/Reports/Commissions"><partial name="_Icon" model='"coins"' />@L["Commissions"]</a></li>
            }
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><partial name="_Icon" model='"user"' />@L["Account settings"]</a></li>
            <li class="d-md-none"><hr class="dropdown-divider" /></li>
            <li class="d-md-none px-2 py-1 d-flex align-items-center justify-content-between gap-2">
                <partial name="_LanguageSwitch" model="Model.ReturnUrl" />
                <partial name="_ThemeToggle" />
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item"><partial name="_Icon" model='"log-out"' />@L["Log out"]</button>
                </form>
            </li>
        </ul>
    </div>
</header>
