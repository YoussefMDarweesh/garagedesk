@* The public landing page for logged-out visitors (shown at "/" by Pages/Index.cshtml).
   Everything here is the same for every visitor. It reads no user, no shop and no database, so it can never show
   anything about any shop. The only setting it uses is the product's own WhatsApp number (Landing:WhatsAppNumber). *@
@using System.Globalization
@using GarageDesk.Web.Services
@inject IConfiguration Configuration
@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var whatsAppUrl = LandingContact.WhatsAppUrl(
        Configuration[LandingContact.ConfigKey],
        L["Hi, I would like to know more about GarageDesk."].Value);

    var features = new (string Icon, string Title, string Text)[]
    {
        ("clipboard", L["Job cards"].Value, L["Parts and labor lines with totals worked out for you, from booked to paid."].Value),
        ("users", L["Customers & vehicles"].Value, L["Find any customer or car in seconds by name, phone or plate number."].Value),
        ("clock", L["Service history"].Value, L["Every visit for a car, newest first, with mileage and what was done."].Value),
        ("file-text", L["Invoices & estimates"].Value, L["Clean A4 invoices and estimates in EGP, with discounts and VAT, ready to print or save as PDF."].Value),
        ("whatsapp", L["WhatsApp links"].Value, L["Send customers a private link to their invoice, estimate or car status. No app and no login for them."].Value),
        ("bell", L["Reminders"].Value, L["See who is due or overdue and message them on WhatsApp in one tap."].Value),
        ("coins", L["Payments & balances"].Value, L["Record part payments and see who owes you at a glance."].Value),
        ("user", L["Your team"].Value, L["Cashiers and technicians get their own logins and see only what they need."].Value),
        ("globe", L["Made for your phone"].Value, L["Arabic or English, light or dark. Add it to your home screen and it opens like an app."].Value),
    };
}

<section class="landing-hero" aria-labelledby="landing-title">
    <div>
        <p class="eyebrow"><span class="landing-mark"><partial name="_BrandMark" model='"tile"' /></span>@L["For small car service shops"]</p>
        <h1 id="landing-title" class="mb-3">@L["One place for every job, car and customer."]</h1>
        <p class="lead mb-4">
            @L["Replace paper job cards, WhatsApp scrolling and Excel sheets with a simple workshop manager. Know what was done, what it cost, and when each car is due back."]
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">@L["Create your shop"]</a>
            <a class="btn btn-lg" style="color:#fff;border:1px solid rgba(255,255,255,.3)" asp-area="Identity" asp-page="/Account/Login">@L["Log in"]</a>
            @if (whatsAppUrl is not null)
            {
                <a class="btn btn-lg landing-whatsapp" href="@whatsAppUrl" target="_blank" rel="noopener noreferrer" data-landing-whatsapp>
                    <partial name="_Icon" model='"whatsapp"' />@L["Talk to us on WhatsApp"]
                </a>
            }
        </div>
        <p class="landing-note mt-3 mb-0">@L["Every shop is its own private space. One shop never sees another shop's data."]</p>
    </div>
    <div class="landing-car"><partial name="_CarSilhouette" /></div>
</section>

<section class="landing-section" aria-labelledby="features-heading">
    <h2 id="features-heading" class="h4 fw-bold text-center mb-4">@L["What GarageDesk does"]</h2>
    <div class="row g-4">
        @foreach (var feature in features)
        {
            <div class="col-md-6 col-lg-4">
                <div class="feature-tile">
                    <span class="icon-tile mb-3"><partial name="_Icon" model="feature.Icon" /></span>
                    <h3 class="h6 fw-bold">@feature.Title</h3>
                    <p class="text-secondary mb-0">@feature.Text</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="landing-section" aria-labelledby="shots-heading">
    <h2 id="shots-heading" class="h4 fw-bold text-center mb-1">@L["See it at work"]</h2>
    <p class="text-secondary text-center mb-4">@L["Real screens from a demo shop."]</p>
    <div class="landing-shots">
        @if (isArabic)
        {
            <figure class="landing-shot landing-shot-phone">
                <img src="~/img/landing/dashboard-ar.jpg" width="480" height="987" loading="lazy" decoding="async"
                     alt="@L["The dashboard on a phone, in Arabic and dark mode"]" />
                <figcaption>@L["The dashboard on a phone, in Arabic and dark mode"]</figcaption>
            </figure>
        }
        <figure class="landing-shot">
            <img src="~/img/landing/dashboard-en.jpg" width="1100" height="955" loading="lazy" decoding="async"
                 alt="@L["The dashboard: today's numbers and who is due"]" />
            <figcaption>@L["The dashboard: today's numbers and who is due"]</figcaption>
        </figure>
        <figure class="landing-shot">
            <img src="~/img/landing/job-card-en.jpg" width="1100" height="764" loading="lazy" decoding="async"
                 alt="@L["A job card: parts, labor and a clear total"]" />
            <figcaption>@L["A job card: parts, labor and a clear total"]</figcaption>
        </figure>
        <figure class="landing-shot">
            <img src="~/img/landing/invoice-en.jpg" width="1100" height="1000" loading="lazy" decoding="async"
                 alt="@L["An invoice, ready to print or save as PDF"]" />
            <figcaption>@L["An invoice, ready to print or save as PDF"]</figcaption>
        </figure>
    </div>
</section>

<section class="landing-section" aria-labelledby="steps-heading">
    <h2 id="steps-heading" class="h4 fw-bold text-center mb-4">@L["Up and running in an afternoon"]</h2>
    <ol class="landing-steps">
        <li>
            <span class="landing-step-number" aria-hidden="true">1</span>
            <h3 class="h6 fw-bold">@L["Create your shop"]</h3>
            <p class="text-secondary mb-0">@L["Register, add your name and logo, and you are in."]</p>
        </li>
        <li>
            <span class="landing-step-number" aria-hidden="true">2</span>
            <h3 class="h6 fw-bold">@L["Add your customers and cars"]</h3>
            <p class="text-secondary mb-0">@L["Type the first ones in, or import your whole list from an Excel file."]</p>
        </li>
        <li>
            <span class="landing-step-number" aria-hidden="true">3</span>
            <h3 class="h6 fw-bold">@L["Run the day from your phone"]</h3>
            <p class="text-secondary mb-0">@L["Job cards, invoices and WhatsApp updates in a few taps."]</p>
        </li>
    </ol>
</section>

<section class="landing-cta" aria-labelledby="cta-heading">
    <h2 id="cta-heading" class="h4 fw-bold mb-2">@L["Ready to try it?"]</h2>
    <p class="mb-4">@L["Create your shop in a minute. Your data stays yours."]</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">@L["Create your shop"]</a>
        <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">@L["Log in"]</a>
        @if (whatsAppUrl is not null)
        {
            <a class="btn btn-outline-secondary btn-lg" href="@whatsAppUrl" target="_blank" rel="noopener noreferrer">
                <partial name="_Icon" model='"whatsapp"' />@L["Talk to us on WhatsApp"]
            </a>
        }
    </div>
</section>
