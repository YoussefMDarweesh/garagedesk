<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GarageDesk: a simple workshop manager for small car service shops." />
    <title>@ViewData["Title"] · GarageDesk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable position-absolute m-2 p-2 bg-white rounded" href="#main">Skip to content</a>

    <header>
        <nav class="navbar navbar-expand-md app-navbar" aria-label="Main">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><span class="brand-dot"></span>GarageDesk</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
                               asp-area="" asp-page="/Index">Home</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="container py-5">
        @RenderBody()
    </main>

    <footer class="app-footer py-3">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year GarageDesk &middot; Prices in EGP</span>
            <a class="link-secondary" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
