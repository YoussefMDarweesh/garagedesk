@using System.Globalization
@using GarageDesk.Web.Data
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ICurrentStaff CurrentStaff
@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    if (!Cultures.Supported.Contains(lang)) { lang = Cultures.Default; }
    var isRtl = Cultures.IsRightToLeft(lang);
    var bootstrapCss = Url.Content("~/lib/bootstrap/dist/css/" + (isRtl ? "bootstrap.rtl.min.css" : "bootstrap.min.css"));
    var currentUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var signedIn = User.Identity?.IsAuthenticated == true;
    var hasShop = User.FindFirst(CurrentShop.ClaimType) is not null;
    var shopName = User.FindFirst(CurrentShop.NameClaimType)?.Value;
    var logoVersion = User.FindFirst(CurrentShop.LogoClaimType)?.Value;
    // Only a known preset name is ever written into the page.
    var accent = User.FindFirst(CurrentShop.AccentClaimType)?.Value;
    var accentAttribute = Accents.IsPreset(accent) && accent != Accents.Default ? $" data-accent=\"{accent}\"" : "";

    // Three kinds of chrome: the app shell (signed in, has a shop), a light public header (visitors, create-shop),
    // or none at all (a page that draws its own, like the split-screen login: ViewData["Chrome"] = "auth").
    var chrome = ViewData["Chrome"] as string ?? (signedIn && hasShop ? "shell" : "public");

    ShellModel? shell = null;
    if (chrome == "shell")
    {
        // The role comes from the database (see ICurrentStaff), so the menu always matches what the server allows.
        var staff = await CurrentStaff.GetAsync();
        var role = staff?.Role ?? ShopRole.Technician; // unknown or deactivated: show the least
        var dueCount = 0;
        if (role != ShopRole.Technician)
        {
            // One small count for the bell. It goes through the DbContext's tenant filter like every other query.
            dueCount = await Db.Reminders.DueOrOverdue(ShopClock.Today()).CountAsync();
        }
        // ui-polish-v2: the menu is grouped (Overview, Workshop, Money, Stock, Admin); see NavBuilder for the role rules.
        var groups = NavBuilder.Build(role, currentPage, Context.Request.Query["show"].FirstOrDefault(), dueCount, L);
        var here = groups.SelectMany(g => g.Items.Select(i => (Group: g, Item: i))).FirstOrDefault(x => x.Item.Active);
        var section = here.Item?.Label ?? ViewData["Title"]?.ToString() ?? "GarageDesk";
        var groupLabel = here.Group is { Collapsible: true } ? here.Group.Label : null;
        shell = new ShellModel(currentPage, section, groups, dueCount, shopName, logoVersion, User.Identity?.Name, currentUrl, role, groupLabel, staff?.DisplayName);
    }
}
<!DOCTYPE html>
<html lang="@lang" dir="@(isRtl ? "rtl" : "ltr")"@Html.Raw(accentAttribute)>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "GarageDesk: a simple workshop manager for small car service shops.")" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · GarageDesk</title>
    <script type="importmap"></script>
    @* Set the theme and the sidebar pin before first paint, so the page never flashes the wrong one. *@
    <script>
        (function () {
            try {
                var root = document.documentElement;
                var theme = localStorage.getItem("gd-theme");
                if (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches) { theme = "dark"; }
                if (theme) { root.setAttribute("data-bs-theme", theme); }
                if (localStorage.getItem("gd-sidebar") === "pinned") { root.setAttribute("data-sidebar", "pinned"); }
            } catch (e) { }
        })();
    </script>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    @* growth-onboarding: installable app (docs/PWA.md). The service worker caches static files only, never pages. *@
    <link rel="icon" type="image/svg+xml" href="~/icons/icon.svg" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0b1324" />
    <meta name="gd-sw" content="@Url.Content("~/sw.js")" data-scope="@Url.Content("~/")"
          data-install-title="@L["Install GarageDesk on this device"]" data-install-action="@L["Install"]"
          data-install-dismiss="@L["Not now"]" data-install-ios="@L["To install: tap Share, then Add to Home Screen."]" />
    @* ui-polish-v2: self-hosted fonts (wwwroot/fonts, OFL). Only the file this page's language needs is fetched early. *@
    <link rel="preload" as="font" type="font/woff2" href="~/fonts/Inter-latin-var.woff2" crossorigin />
    @if (isRtl)
    {
        <link rel="preload" as="font" type="font/woff2" href="~/fonts/IBMPlexSansArabic-500-arabic.woff2" crossorigin />
    }
    <link rel="stylesheet" href="@bootstrapCss" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(chrome == "shell" ? "app" : chrome == "auth" ? "auth" : "public")">
    <a class="visually-hidden-focusable position-absolute m-2 p-2 bg-white text-dark rounded" href="#main">@L["Skip to content"]</a>

    @if (shell is not null)
    {
        <div class="app-shell">
            <partial name="_Sidebar" model="shell" />

            <div class="app-main">
                <div class="sheet">
                    <partial name="_Topbar" model="shell" />

                    <main id="main" class="sheet-body">
                        @RenderBody()
                    </main>
                </div>

                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year GarageDesk &middot; @L["Prices in EGP"]</span>
                    <a asp-area="" asp-page="/Privacy">@L["Privacy"]</a>
                </footer>
            </div>

            <partial name="_TabBar" model="shell" />
        </div>
    }
    else if (chrome == "auth")
    {
        <main id="main">
            @RenderBody()
        </main>
    }
    else
    {
        <header class="public-header">
            <a class="public-brand" asp-area="" asp-page="/Index">
                <span class="brand-tile"><partial name="_Icon" model='"tool"' /></span>
                <span>GarageDesk</span>
            </a>
            <span class="flex-fill"></span>
            <partial name="_LanguageSwitch" model="currentUrl" />
            <partial name="_ThemeToggle" />
            @if (signedIn)
            {
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@L["Log out"]</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-secondary btn-sm d-none d-sm-inline-flex" asp-area="Identity" asp-page="/Account/Login">@L["Log in"]</a>
                <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">@L["Create your shop"]</a>
            }
        </header>

        <main id="main" class="public-main">
            @RenderBody()
        </main>

        <footer class="public-footer">
            <span>&copy; @DateTime.Now.Year GarageDesk &middot; @L["Prices in EGP"]</span>
            <a asp-area="" asp-page="/Privacy">@L["Privacy"]</a>
        </footer>
    }

    <div class="toasts" id="toasts" aria-live="polite" aria-atomic="false"></div>

    <dialog class="confirm" id="confirm-dialog" aria-labelledby="confirm-title">
        <form method="dialog">
            <h2 id="confirm-title">@L["Are you sure?"]</h2>
            <p id="confirm-message"></p>
            <div class="actions">
                <button type="submit" value="cancel" class="btn btn-outline-secondary">@L["Cancel"]</button>
                <button type="submit" value="ok" class="btn btn-primary" id="confirm-ok">@L["Yes, continue"]</button>
            </div>
        </form>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
