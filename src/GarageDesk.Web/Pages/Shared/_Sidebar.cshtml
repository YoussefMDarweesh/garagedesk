@* The floating navy rail. Icons only until hovered, focused or pinned; then the labels slide out.
   It sits at the inline-start edge, so in Arabic it is on the right without any extra CSS. *@
@model GarageDesk.Web.Services.ShellModel
@using GarageDesk.Web.Services
<aside class="sidebar" id="sidebar" aria-label="@L["Main navigation"]">
    <a class="sidebar-brand" asp-area="" asp-page="/Index">
        @if (Model.LogoVersion is not null)
        {
            <span class="brand-tile has-logo"><img src="@Url.Content("~" + ShopLogoEndpoint.Path)?v=@Model.LogoVersion" alt="@Model.ShopName" /></span>
        }
        else
        {
            <span class="brand-tile"><partial name="_Icon" model='"tool"' /></span>
        }
        <span class="rail-text">
            <span class="rail-brand-name">GarageDesk</span>
            <span class="rail-brand-sub">@Model.ShopName</span>
        </span>
    </a>

    <ul class="rail-nav">
        @foreach (var item in Model.Items)
        {
            var active = item.Page == "/Index"
                ? Model.CurrentPage == "/Index"
                : Model.CurrentPage.StartsWith(item.Prefix, StringComparison.Ordinal);
            <li>
                <a class="rail-link @(active ? "active" : "")" asp-area="" asp-page="@item.Page"
                   aria-current="@(active ? "page" : null)" title="@item.Label">
                    <partial name="_Icon" model="item.Icon" />
                    <span class="rail-text">@item.Label</span>
                    @if (item.Badge > 0)
                    {
                        <span class="rail-badge rail-text num">@item.Badge</span>
                    }
                </a>
            </li>
        }
    </ul>

    <div class="rail-foot">
        <button type="button" class="rail-link rail-pin" id="sidebar-pin" aria-pressed="false" title="@L["Keep the menu open"]">
            <partial name="_Icon" model='"pin"' />
            <span class="rail-text">@L["Keep the menu open"]</span>
        </button>
    </div>
</aside>
