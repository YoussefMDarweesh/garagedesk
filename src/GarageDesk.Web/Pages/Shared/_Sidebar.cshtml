@* The floating navy rail. Icons only until hovered, focused or pinned; then the labels slide out.
   It sits at the inline-start edge, so in Arabic it is on the right without any extra CSS.
   ui-polish-v2: the links are grouped into labelled, collapsible sections (see NavBuilder for who sees what).
   The brand and the pin button stay in place; only the middle scrolls when the window is short.
   Without JavaScript every section is simply open. *@
@model GarageDesk.Web.Services.ShellModel
@using GarageDesk.Web.Services
@{
    var logoView = Model.LogoVersion is null
        ? null
        : new ShopLogoView(Url.Content("~" + ShopLogoEndpoint.Path) + "?v=" + Model.LogoVersion, Model.ShopName ?? "", "rail");
}
<aside class="sidebar" id="sidebar">
    @* brand-logo: the top of the rail has a fixed height, so it never jumps when the rail opens. With a logo, the logo
       sits on its plate (about 46 px when the rail is icon-only, a wide 56 px plate when open) and the shop name comes
       under it, with "GarageDesk" as the small second line. Without a logo, the GarageDesk mark (tinted with the shop's
       accent) and wordmark take its place. *@
    <a class="sidebar-brand @(Model.LogoVersion is not null ? "has-logo" : "")" asp-area="" asp-page="/Index" title="@Model.ShopName">
        @if (Model.LogoVersion is not null)
        {
            <span class="rail-brand-top">
                <partial name="_ShopLogo" model="logoView" />
            </span>
            <span class="rail-brand-row">
                <span class="rail-brand-mini" aria-hidden="true"><partial name="_BrandMark" model='"tile"' /></span>
                <span class="rail-text rail-brand-text">
                    <span class="rail-brand-name"><bdi>@Model.ShopName</bdi></span>
                    <span class="rail-brand-sub">GarageDesk</span>
                </span>
            </span>
        }
        else
        {
            <span class="rail-brand-top rail-lockup">
                <span class="rail-lockup-mark"><partial name="_BrandMark" model='"tile"' /></span>
                <span class="rail-text rail-lockup-word"><partial name="_BrandWord" /></span>
            </span>
            <span class="rail-brand-row">
                <span class="rail-text rail-brand-text">
                    <span class="rail-brand-name"><bdi>@Model.ShopName</bdi></span>
                </span>
            </span>
        }
    </a>

    <nav class="rail-scroll" aria-label="@L["Main navigation"]">
        @foreach (var group in Model.Groups)
        {
            var open = group.DefaultOpen || group.HasActive || !group.Collapsible;
            var listId = $"rail-{group.Key}";
            <div class="rail-group @(open ? "is-open" : "") @(group.HasActive ? "has-active" : "")" data-group="@group.Key">
                @if (group.Collapsible)
                {
                    <button type="button" class="rail-group-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@listId" title="@group.Label">
                        <span class="rail-group-icon"><partial name="_Icon" model="group.Icon" /></span>
                        <span class="rail-text rail-group-label">@group.Label</span>
                        @if (group.Badge > 0)
                        {
                            <span class="rail-badge rail-group-badge rail-text num">@group.Badge</span>
                        }
                        <span class="rail-text rail-chevron"><partial name="_Icon" model='"chevron-down"' /></span>
                    </button>
                }
                else
                {
                    <p class="rail-group-toggle rail-group-static"><span class="rail-text rail-group-label">@group.Label</span></p>
                }
                <ul class="rail-nav" id="@listId">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <a class="rail-link @(item.Active ? "active" : "")" asp-area="" asp-page="@item.Page" asp-all-route-data="@(item.Route ?? new Dictionary<string, string>())"
                               aria-current="@(item.Active ? "page" : null)" title="@item.Label">
                                <partial name="_Icon" model="item.Icon" />
                                <span class="rail-text">@item.Label</span>
                                @if (item.Badge > 0)
                                {
                                    <span class="rail-badge rail-text num">@item.Badge</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
    @* Apply the remembered open/closed sections right away, before the page paints (the active section always stays open). *@
    <script>(function(){try{var s=JSON.parse(localStorage.getItem("gd-nav")||"{}");document.querySelectorAll(".rail-group[data-group]").forEach(function(g){var k=g.getAttribute("data-group");if(g.classList.contains("has-active")||!(k in s)){return;}var o=!!s[k];g.classList.toggle("is-open",o);var b=g.querySelector(".rail-group-toggle");if(b){b.setAttribute("aria-expanded",o?"true":"false");}});}catch(e){}})();</script>

    <div class="rail-foot">
        <button type="button" class="rail-link rail-pin" id="sidebar-pin" aria-pressed="false" title="@L["Keep the menu open"]">
            <partial name="_Icon" model='"pin"' />
            <span class="rail-text">@L["Keep the menu open"]</span>
        </button>
    </div>
</aside>
