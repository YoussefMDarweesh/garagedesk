@* Light / dark switch. site.js wires every .js-theme-toggle; the choice is remembered in the browser. *@
<button type="button" class="icon-btn theme-toggle js-theme-toggle" aria-label="@L["Switch between light and dark theme"]" aria-pressed="false" title="@L["Switch between light and dark theme"]">
    <partial name="_Icon" model='"moon"' />
    <partial name="_Icon" model='"sun"' />
</button>
