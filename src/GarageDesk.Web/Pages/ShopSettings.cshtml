@page
@using GarageDesk.Web.Services
@model ShopSettingsModel
@{
    ViewData["Title"] = L["Shop settings"].Value;
    var logoVersion = User.FindFirst(CurrentShop.LogoClaimType)?.Value;
    var shopName = User.FindFirst(CurrentShop.NameClaimType)?.Value;
    var logoSrc = logoVersion is null ? "" : Url.Content("~" + ShopLogoEndpoint.Path) + "?v=" + logoVersion;
    var logoView = logoVersion is null ? null : new ShopLogoView(logoSrc, shopName ?? "", "card");
    var logoXl = new ShopLogoView(logoSrc, shopName ?? "", "xl");
    var logoRail = new ShopLogoView(logoSrc, shopName ?? "", "rail");
    var logoTile = new ShopLogoView(logoSrc, shopName ?? "", "tile");
    var logoCard = new ShopLogoView(logoSrc, shopName ?? "", "card");
    var logoSm = new ShopLogoView(logoSrc, shopName ?? "", "sm");
}

<div class="narrow" style="max-width: 46rem">
    <div class="page-head">
        <div>
            <h1 class="visually-hidden">@L["Shop settings"]</h1>
            <p class="page-sub mt-0">@shopName</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="toast-source" data-toast="success" role="status">@Model.StatusMessage</div>
    }

    <section class="panel panel-pad mb-4" aria-labelledby="logo-heading" data-logo-section>
        <div class="panel-head mb-1"><h2 id="logo-heading" class="panel-title">@L["Shop logo"]</h2></div>
        <p class="text-secondary">@L["PNG, JPEG or WebP, up to 512 KB. It appears in the navigation bar."]</p>

        <div class="logo-current">
            @if (Model.HasLogo && logoView is not null)
            {
                <partial name="_ShopLogo" model="logoXl" />
                <div class="logo-current-meta">
                    @if (Model.LogoSize is { } size)
                    {
                        <p class="mb-0 small text-secondary" data-logo-size>@L["Your logo is {0} × {1} px.", size.Width, size.Height]</p>
                    }
                    @if (Model.LogoIsSmall)
                    {
                        <p class="logo-hint" role="note" data-logo-small><partial name="_Icon" model='"alert"' /><span>@L["This logo is small and may look blurry. For a sharp result use at least 512 px on its short side."]</span></p>
                    }
                </div>
            }
            else
            {
                <span class="topbar-mark" aria-hidden="true"><partial name="_BrandMark" model='"tile"' /></span>
                <span class="text-secondary">@L["No logo yet."]</span>
            }
        </div>

        <partial name="_FormErrors" />

        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
            <label class="form-label fw-semibold" for="upload">@L["Logo image"]</label>
            <input id="upload" name="upload" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" required />
            <button type="submit" class="btn btn-primary mt-3">@L["Upload"]</button>
        </form>

        <div class="logo-tips" data-logo-tips>
            <h3>@L["Upload tips"]</h3>
            <ul>
                <li>@L["Best: a transparent PNG, at least 512 × 512 px for a square mark or 1024 × 256 px for a wide wordmark, under 512 KB."]</li>
                <li>@L["Dark or colourful logos work best. A logo that is only white disappears on the light plate."]</li>
                <li>@L["Avoid tiny text inside the picture: it cannot be read at menu size."]</li>
            </ul>
        </div>

        @if (Model.HasLogo)
        {
            <form method="post" asp-page-handler="Remove" class="mt-3" data-confirm="@L["Remove the shop logo?"]">
                <button type="submit" class="btn btn-outline-secondary">@L["Remove logo"]</button>
            </form>
        }

        @if (Model.HasLogo && logoView is not null)
        {
            @* brand-logo: how the logo looks where owners and customers will meet it. Every frame reuses the same /shop/logo URL (one request). *@
            <div class="logo-preview" data-logo-preview>
                <h3 class="panel-title mb-3">@L["Logo preview"]</h3>
                <div class="logo-preview-grid">
                    <figure class="logo-frame">
                        <div class="lf-stage lf-dark">
                            <div class="lf-rail-open">
                                <partial name="_ShopLogo" model="logoRail" />
                                <span class="lf-name"><bdi>@shopName</bdi></span>
                                <span class="lf-sub">GarageDesk</span>
                            </div>
                            <div class="lf-rail-icon"><partial name="_ShopLogo" model="logoTile" /></div>
                        </div>
                        <figcaption>@L["In the dark menu"]</figcaption>
                    </figure>
                    <figure class="logo-frame">
                        <div class="lf-stage lf-light">
                            <div class="lf-row">
                                <partial name="_ShopLogo" model="logoCard" />
                                <div class="min-w-0"><span class="lf-name"><bdi>@shopName</bdi></span><span class="lf-sub">GarageDesk</span></div>
                            </div>
                        </div>
                        <figcaption>@L["On the light plate"]</figcaption>
                    </figure>
                    <figure class="logo-frame">
                        <div class="lf-stage lf-paper">
                            <div class="lf-paper-head">
                                <img class="inv-logo" src="@logoSrc" alt="@shopName" />
                                <span class="lf-paper-title">@L["Invoice"]</span>
                            </div>
                            <span class="lf-name"><bdi>@shopName</bdi></span>
                            <span class="lf-bar w80"></span>
                            <span class="lf-bar w60"></span>
                            <span class="lf-bar w40"></span>
                        </div>
                        <figcaption>@L["On an invoice"]</figcaption>
                    </figure>
                    <figure class="logo-frame">
                        <div class="lf-stage lf-phone-wrap">
                            <div class="lf-phone">
                                <div class="lf-phone-screen">
                                    <div class="lf-phone-bar">
                                        <partial name="_ShopLogo" model="logoSm" />
                                        <span class="lf-bar"></span>
                                    </div>
                                    <span class="lf-phone-card"></span>
                                    <span class="lf-phone-card"></span>
                                </div>
                            </div>
                        </div>
                        <figcaption>@L["On a phone"]</figcaption>
                    </figure>
                </div>
            </div>
        }
    </section>

    <section class="panel panel-pad mt-4" aria-labelledby="vat-heading">
        <div class="panel-head mb-1"><h2 id="vat-heading" class="panel-title">@L["VAT"]</h2></div>
        <p class="text-secondary small">@L["Leave empty if your shop does not charge VAT. It is added to job cards when they are issued (Done or Paid)."]</p>
        <form method="post" asp-page-handler="Vat" class="d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label for="vatPercent" class="form-label small text-secondary">@L["VAT percent"]</label>
                <input id="vatPercent" name="vatPercent" type="number" step="0.01" min="0" max="100" class="form-control" value="@Model.VatPercent?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-vat-input />
            </div>
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
        </form>
    </section>

    <section class="panel panel-pad mt-4 mb-4" aria-labelledby="share-message-heading">
        <div class="panel-head mb-1"><h2 id="share-message-heading" class="panel-title">@L["WhatsApp message"]</h2></div>
        <p class="text-secondary small">@L["The text that opens in WhatsApp when you send a link to a customer. Leave a box empty to use the built-in wording."]</p>
        <p class="small mb-3">
            @L["You can use"]
            @foreach (var placeholder in ShareMessage.Placeholders)
            {
                <code class="ltr me-1">@placeholder</code>
            }
            &mdash; @L["{name} is the customer, {plate} the car, {shop} your shop and {link} the private link."]
        </p>
        @if (ViewData.ModelState.TryGetValue("shareMessage", out var shareError) && shareError.Errors.Count > 0)
        {
            <div class="validation-summary-errors" role="alert" data-share-message-error>@shareError.Errors[0].ErrorMessage</div>
        }
        <form method="post" asp-page-handler="ShareMessage">
            <div class="mb-3">
                <label for="shareMessageEn" class="form-label small text-secondary">@L["Message in English"]</label>
                <textarea id="shareMessageEn" name="shareMessageEn" rows="3" maxlength="500" class="form-control" dir="ltr" placeholder="Hi {name}, your car {plate} is ready. Details: {link}">@Model.ShareMessageEn</textarea>
            </div>
            <div class="mb-3">
                <label for="shareMessageAr" class="form-label small text-secondary">@L["Message in Arabic"]</label>
                <textarea id="shareMessageAr" name="shareMessageAr" rows="3" maxlength="500" class="form-control" dir="rtl" placeholder="مرحبًا {name}، سيارتك {plate} جاهزة. التفاصيل: {link}">@Model.ShareMessageAr</textarea>
            </div>
            <button type="submit" class="btn btn-primary" data-save-share-message>@L["Save"]</button>
        </form>
    </section>

    <section class="panel panel-pad" aria-labelledby="accent-heading">
        <div class="panel-head mb-1"><h2 id="accent-heading" class="panel-title">@L["Accent colour"]</h2></div>
        <p class="text-secondary">@L["Pick the colour used for buttons, highlights and the car on your vehicle pages."]</p>

        <form method="post" asp-page-handler="Accent">
            <div class="accent-swatches" role="radiogroup" aria-label="@L["Accent colour"]">
                @foreach (var preset in Accents.Presets)
                {
                    <label class="accent-swatch" title="@L[preset]" style="--swatch: @Accents.Swatch(preset)">
                        <input type="radio" name="accent" value="@preset" checked="@(preset == Model.Accent)" />
                        <span><partial name="_Icon" model='"check"' /></span>
                        <span class="visually-hidden">@L[preset]</span>
                    </label>
                }
            </div>
            <button type="submit" class="btn btn-primary mt-4">@L["Save"]</button>
        </form>
    </section>
</div>
