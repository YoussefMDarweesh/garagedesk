@page
@model PrivacyModel
@{
    ViewData["Title"] = L["Privacy"].Value;
}

<div class="narrow mx-auto">
    <h1 class="h2 fw-bold mb-4">@L["Privacy"]</h1>

    <p>@L["GarageDesk is a workshop manager that is still under development. This page explains, in plain terms, what it stores."]</p>

    <h2 class="h5 mt-4">@L["What we store"]</h2>
    <ul>
        <li>@L["Your account: your email address and a securely hashed password (we never store the password itself)."]</li>
        <li>@L["Your shop's details and, as the app grows, the customers, vehicles and jobs you enter."]</li>
    </ul>

    <h2 class="h5 mt-4">@L["Who can see it"]</h2>
    <p>@L["Each shop is separate. Signed-in users only ever see their own shop's data."]</p>

    <h2 class="h5 mt-4">@L["Cookies"]</h2>
    <p>@L["One cookie keeps you signed in and another remembers your language. Your light or dark theme is saved in your browser. There is no advertising or tracking."]</p>
</div>
