@page
@model IndexModel
@{
    ViewData["Title"] = L["Vehicles"].Value;
    var searching = !string.IsNullOrWhiteSpace(Model.Q);
}

<div class="page-head">
    <div>
        <h1 class="visually-hidden">@L["Vehicles"]</h1>
        <p class="page-sub mt-0">@L["{0} vehicles", Model.Total]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="Create"><partial name="_Icon" model='"plus"' />@L["Add vehicle"]</a>
    </div>
</div>

<form method="get" class="toolbar" role="search">
    <div class="search-field">
        <partial name="_Icon" model='"search"' />
        <input type="search" name="q" value="@Model.Q" class="form-control"
               placeholder="@L["Search by plate, make, model or owner"]" aria-label="@L["Search by plate, make, model or owner"]" />
    </div>
    <div class="page-actions">
        <button type="submit" class="btn btn-outline-secondary">@L["Search"]</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-page="Index">@L["Clear"]</a>
        }
    </div>
</form>

@if (Model.Vehicles.Count == 0)
{
    <section class="panel">
        <div class="empty">
            <span class="icon-tile"><partial name="_Icon" model='searching ? "search" : "car"' /></span>
            @if (searching)
            {
                <h2>@L["No vehicles match your search."]</h2>
                <p>@L["Try a different plate, make, model or owner."]</p>
            }
            else
            {
                <h2>@L["No vehicles yet."]</h2>
                <p>@L["Add a vehicle from a customer's page, or use the button above."]</p>
            }
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Plate number"]</th>
                        <th scope="col">@L["Vehicle"]</th>
                        <th scope="col">@L["Year"]</th>
                        <th scope="col" class="cell-end">@L["Mileage (km)"]</th>
                        <th scope="col">@L["Owner"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td><a class="plate" asp-page="Details" asp-route-id="@vehicle.Id">@PlateFormat.Html(vehicle.Plate)</a></td>
                        <td class="fw-semibold">@vehicle.Make @vehicle.Model</td>
                        <td class="num">@vehicle.Year</td>
                        <td class="cell-end num">@vehicle.Mileage.ToString("N0")</td>
                        <td>
                            @if (vehicle.Customer is not null)
                            {
                                <div class="identity">
                                    <partial name="_Avatar" model="vehicle.Customer.Name" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-sm" }' />
                                    <a class="identity-name" asp-page="/Customers/Details" asp-route-id="@vehicle.CustomerId">@vehicle.Customer.Name</a>
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="Model.Pager" />
}
