@page
@model GarageDesk.Web.Pages.Money.ExpensesModel
@{
    ViewData["Title"] = L["Expenses"].Value;
}

<div class="page-head">
    <div>
        <p class="eyebrow mb-1">@L["Owner only"]</p>
        <h1>@L["Expenses"]</h1>
        <p class="page-sub"><span class="ltr num" data-month>@Model.MonthStart.ToString("yyyy-MM")</span></p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-page="Expenses" asp-route-month="@Model.PreviousKey"><partial name="_Icon" model='"chevron-left"' />@L["Previous month"]</a>
        <a class="btn btn-outline-secondary" asp-page="Expenses" asp-route-month="@Model.NextKey">@L["Next month"]</a>
    </div>
</div>

<partial name="_MoneyTabs" model='"expenses"' />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="toast-source" data-toast="success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="toast-source" data-toast="danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-3 g-lg-4">
    <div class="col-lg-4">
        <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="add-heading">
            <div class="panel-head"><h2 id="add-heading" class="panel-title">@L["Add an expense"]</h2></div>
            <form method="post" novalidate>
                <partial name="_FormErrors" />
                <div class="mb-2">
                    <label asp-for="Input.Date" class="form-label small text-secondary"></label>
                    <input asp-for="Input.Date" type="date" class="form-control" />
                    <span asp-validation-for="Input.Date"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.CategoryId" class="form-label small text-secondary"></label>
                    <select asp-for="Input.CategoryId" class="form-select">
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@Model.CategoryName(category.Name)</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Amount" class="form-label small text-secondary"></label>
                    <input asp-for="Input.Amount" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
                    <span asp-validation-for="Input.Amount"></span>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Note" class="form-label small text-secondary"></label>
                    <input asp-for="Input.Note" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Note"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.PaidFromCash" class="form-check-input" />
                    <label asp-for="Input.PaidFromCash" class="form-check-label small"></label>
                    <div class="form-text">@L["Cash taken out of the drawer lowers the cash you should have at the end of the day."]</div>
                </div>
                <button type="submit" class="btn btn-primary w-100"><partial name="_Icon" model='"plus"' />@L["Add expense"]</button>
            </form>
            <p class="mt-3 mb-0 small"><a asp-page="Categories">@L["Edit categories"]</a></p>
        </section>

        <section class="panel panel-pad" aria-labelledby="totals-heading">
            <div class="panel-head"><h2 id="totals-heading" class="panel-title">@L["By category"]</h2></div>
            @if (Model.Totals.Count == 0)
            {
                <p class="text-secondary mb-0">@L["No expenses this month."]</p>
            }
            else
            {
                <dl class="row mb-0 g-1" data-category-totals>
                    @foreach (var total in Model.Totals)
                    {
                        <dt class="col-6 text-secondary fw-normal">@Model.CategoryName(total.Category)</dt>
                        <dd class="col-6 text-end mb-1" data-category="@total.Category"><partial name="_Money" model="total.Total" /></dd>
                    }
                    <dt class="col-6 border-top pt-2 mb-0">@L["Total"]</dt>
                    <dd class="col-6 text-end border-top pt-2 mb-0 fw-bold" data-expenses-total><partial name="_Money" model="Model.Total" /></dd>
                </dl>
            }
        </section>
    </div>

    <div class="col-lg-8">
        <section class="panel panel-pad" aria-labelledby="list-heading">
            <div class="panel-head"><h2 id="list-heading" class="panel-title">@L["This month"]</h2></div>
            @if (Model.Rows.Count == 0)
            {
                <div class="empty">
                    <span class="icon-tile"><partial name="_Icon" model='"coins"' /></span>
                    <p>@L["No expenses this month."]</p>
                </div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table" data-expenses>
                        <thead>
                            <tr>
                                <th scope="col">@L["Date"]</th>
                                <th scope="col">@L["Category"]</th>
                                <th scope="col">@L["Note"]</th>
                                <th scope="col" class="cell-end">@L["Amount (EGP)"]</th>
                                <th scope="col"><span class="visually-hidden">@L["Remove"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><span class="ltr num">@row.Date.ToString("yyyy-MM-dd")</span></td>
                                <td>
                                    @Model.CategoryName(row.Category)
                                    @if (!row.PaidFromCash) { <span class="chip">@L["Not from the drawer"]</span> }
                                </td>
                                <td>@row.Note</td>
                                <td class="cell-end fw-bold"><partial name="_Money" model="row.Amount" /></td>
                                <td class="cell-end">
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id" asp-route-month="@Model.MonthStart.ToString("yyyy-MM")"
                                          data-confirm="@L["Remove this expense?"]">
                                        <button type="submit" class="icon-btn" title="@L["Remove"]" aria-label="@L["Remove"]"><partial name="_Icon" model='"x"' /></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
