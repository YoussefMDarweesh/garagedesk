@page
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@model IndexModel
@{
    ViewData["Title"] = L["Job cards"].Value;
    var searching = !string.IsNullOrWhiteSpace(Model.Q) || Model.StatusFilter is not null;
    var statuses = new[] { JobStatus.Booked, JobStatus.InProgress, JobStatus.Done, JobStatus.Paid };
}

<div class="page-head">
    <div>
        <h1 class="visually-hidden">@L["Job cards"]</h1>
        <p class="page-sub mt-0">@L["{0} job cards", Model.Total]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-page="Create"><partial name="_Icon" model='"plus"' />@L["New job card"]</a>
    </div>
</div>

<div class="toolbar">
    <div class="seg" role="group" aria-label="@L["Status"]">
        <a class="@(Model.StatusFilter is null ? "active" : "")" asp-page="Index" asp-route-q="@Model.Q">@L["All"]</a>
        @foreach (var status in statuses)
        {
            <a class="@(Model.StatusFilter == status ? "active" : "")"
               asp-page="Index" asp-route-q="@Model.Q" asp-route-status="@status">
                <partial name="_StatusLabel" model="status" />
            </a>
        }
    </div>

    <form method="get" role="search" class="d-flex flex-wrap gap-2 flex-fill justify-content-end">
        @if (Model.StatusFilter is JobStatus current)
        {
            <input type="hidden" name="status" value="@current" />
        }
        <div class="search-field">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Q" class="form-control"
                   placeholder="@L["Search by plate, owner or job number"]" aria-label="@L["Search by plate, owner or job number"]" />
        </div>
        <button type="submit" class="btn btn-outline-secondary">@L["Search"]</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-page="Index">@L["Clear"]</a>
        }
    </form>
</div>

@if (Model.Jobs.Count == 0)
{
    <section class="panel">
        <div class="empty">
            <span class="icon-tile"><partial name="_Icon" model='searching ? "search" : "clipboard"' /></span>
            @if (searching)
            {
                <h2>@L["No job cards match your search."]</h2>
                <p>@L["Try a different plate, owner or job number, or another status."]</p>
            }
            else
            {
                <h2>@L["No job cards yet."]</h2>
                <p>@L["Open one from a vehicle's page, or use the button above."]</p>
                <a class="btn btn-primary mt-2" asp-page="Create">@L["New job card"]</a>
            }
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Job"]</th>
                        <th scope="col">@L["Date in"]</th>
                        <th scope="col">@L["Vehicle"]</th>
                        <th scope="col">@L["Owner"]</th>
                        <th scope="col">@L["Status"]</th>
                        <th scope="col" class="cell-end">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td><a class="identity-name" asp-page="Details" asp-route-id="@job.Id"><span class="ltr num">#@job.Id</span></a>@if (job.InvoiceLabel is not null) { <div class="small text-secondary ltr num">@job.InvoiceLabel</div> }</td>
                        <td><span class="ltr num">@job.DateIn.ToString("yyyy-MM-dd")</span></td>
                        <td>
                            <span class="plate" dir="auto">@job.Vehicle?.Plate</span>
                            <span class="text-secondary ms-1">@job.Vehicle?.Make @job.Vehicle?.Model</span>
                        </td>
                        <td>
                            @if (job.Vehicle?.Customer is { } owner)
                            {
                                <div class="identity">
                                    <partial name="_Avatar" model="owner.Name" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-sm" }' />
                                    <span>@owner.Name</span>
                                </div>
                            }
                        </td>
                        <td><partial name="_StatusBadge" model="job.Status" /></td>
                        <td class="cell-end fw-bold"><partial name="_Money" model="job.Total" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="Model.Pager" />
}
