@page
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@model IndexModel
@{
    ViewData["Title"] = L["Job cards"].Value;
    var searching = !string.IsNullOrWhiteSpace(Model.Q) || Model.StatusFilter is not null;
    var statuses = new[] { JobStatus.Booked, JobStatus.InProgress, JobStatus.Done, JobStatus.Paid };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h2 fw-bold mb-0">@L["Job cards"]</h1>
    <a class="btn btn-primary" asp-page="Create">@L["New job card"]</a>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter is null ? "active" : "")" asp-page="Index" asp-route-q="@Model.Q">@L["All"]</a>
    </li>
    @foreach (var status in statuses)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == status ? "active" : "")"
               asp-page="Index" asp-route-q="@Model.Q" asp-route-status="@status">
                <partial name="_StatusLabel" model="status" />
            </a>
        </li>
    }
</ul>

<form method="get" class="mb-4" role="search">
    @if (Model.StatusFilter is JobStatus current)
    {
        <input type="hidden" name="status" value="@current" />
    }
    <div class="input-group">
        <input type="search" name="q" value="@Model.Q" class="form-control"
               placeholder="@L["Search by plate, owner or job number"]" aria-label="@L["Search by plate, owner or job number"]" />
        <button type="submit" class="btn btn-outline-secondary">@L["Search"]</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-page="Index">@L["Clear"]</a>
        }
    </div>
</form>

@if (Model.Jobs.Count == 0)
{
    <div class="card"><div class="card-body p-4 text-center text-secondary">
        @if (searching)
        {
            <p class="mb-0">@L["No job cards match your search."]</p>
        }
        else
        {
            <p>@L["No job cards yet. Open one from a vehicle's page, or use the button above."]</p>
        }
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@L["Job"]</th>
                        <th scope="col">@L["Date in"]</th>
                        <th scope="col">@L["Vehicle"]</th>
                        <th scope="col">@L["Owner"]</th>
                        <th scope="col">@L["Status"]</th>
                        <th scope="col" class="text-end">@L["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td><a class="fw-semibold" asp-page="Details" asp-route-id="@job.Id"><span class="ltr">#@job.Id</span></a></td>
                        <td><span class="ltr">@job.DateIn.ToString("yyyy-MM-dd")</span></td>
                        <td>
                            <span class="plate" dir="auto">@job.Vehicle?.Plate</span>
                            <span class="text-secondary">@job.Vehicle?.Make @job.Vehicle?.Model</span>
                        </td>
                        <td>@job.Vehicle?.Customer?.Name</td>
                        <td><partial name="_StatusBadge" model="job.Status" /></td>
                        <td class="text-end"><partial name="_Money" model="job.Total" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.HasMore)
    {
        <p class="text-secondary small mt-3">@L["Showing the newest {0} job cards. Use the search or a status to narrow the list.", IndexModel.PageSize]</p>
    }
}
