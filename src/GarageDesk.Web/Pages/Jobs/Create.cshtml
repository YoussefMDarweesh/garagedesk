@page
@model CreateModel
@{
    ViewData["Title"] = L["New job card"].Value;
}

<div class="card shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-4">@L["New job card"]</h1>

        @if (Model.Vehicle is null && Model.VehicleOptions.Count == 0)
        {
            <p class="text-secondary">@L["A job card is opened for a vehicle. Add a vehicle first."]</p>
            <a class="btn btn-primary" asp-page="/Vehicles/Create">@L["Add vehicle"]</a>
        }
        else
        {
            <form method="post" novalidate>
                <partial name="_FormErrors" />

                @if (Model.Vehicle is { } vehicle)
                {
                    <input type="hidden" asp-for="Input.VehicleId" />
                    <div class="mb-3 p-3 rounded border">
                        <span class="plate" dir="auto">@vehicle.Plate</span>
                        <span class="ms-1">@vehicle.Make @vehicle.Model</span>
                        <div class="text-secondary small mt-1">@vehicle.Customer?.Name</div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="Input.VehicleId" class="form-label"></label>
                        <select asp-for="Input.VehicleId" asp-items="Model.VehicleOptions" class="form-select">
                            <option value="0">@L["Choose the vehicle."]</option>
                        </select>
                        <span asp-validation-for="Input.VehicleId"></span>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.DateIn" type="date" class="form-control" placeholder="@L["Date in"]" />
                            <label asp-for="Input.DateIn"></label>
                        </div>
                        <span asp-validation-for="Input.DateIn"></span>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.MileageAtVisit" type="number" inputmode="numeric" class="form-control" placeholder="@L["Mileage at visit (km)"]" />
                            <label asp-for="Input.MileageAtVisit"></label>
                        </div>
                        <span asp-validation-for="Input.MileageAtVisit"></span>
                    </div>
                </div>

                @if (Model.AssigneeOptions.Count > 0)
                {
                    <div class="form-floating mb-3">
                        <select asp-for="Input.AssignedToUserId" asp-items="Model.AssigneeOptions" class="form-select">
                            <option value="">@L["Not assigned"]</option>
                        </select>
                        <label asp-for="Input.AssignedToUserId"></label>
                        <span asp-validation-for="Input.AssignedToUserId"></span>
                    </div>
                }

                <div class="form-floating mb-4">
                    <textarea asp-for="Input.Notes" class="form-control" placeholder="@L["Notes"]" style="height: 7rem"></textarea>
                    <label asp-for="Input.Notes"></label>
                    <span asp-validation-for="Input.Notes"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Open job card"]</button>
                    <a class="btn btn-outline-secondary" asp-page="Index">@L["Cancel"]</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
