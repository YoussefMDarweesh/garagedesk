@* The job card's history: who created it, changed its status, took a payment or assigned it. Owners only. *@
@model List<GarageDesk.Web.Models.JobAuditEntry>
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@functions {
    string StatusName(string name) => name switch
    {
        "Booked" => L["Booked"].Value,
        "InProgress" => L["In progress"].Value,
        "Done" => L["Done"].Value,
        "Paid" => L["Paid"].Value,
        _ => name,
    };

    string MethodName(string name) => name switch
    {
        "Card" => L["Card"].Value,
        "BankTransfer" => L["Bank transfer"].Value,
        "Wallet" => L["Wallet"].Value,
        _ => L["Cash"].Value,
    };

    string Describe(JobAuditEntry entry)
    {
        var parts = entry.Detail.Split('>', '|');
        return entry.Kind switch
        {
            JobAuditKind.Created => string.IsNullOrEmpty(entry.Detail)
                ? L["Job card created"].Value
                : L["Job card created from estimate {0}", entry.Detail].Value,
            JobAuditKind.StatusChanged when parts.Length == 2 => L["Status changed from {0} to {1}", StatusName(parts[0]), StatusName(parts[1])].Value,
            JobAuditKind.PaymentAdded when parts.Length == 2 => L["Payment of {0} EGP received ({1})", parts[0], MethodName(parts[1])].Value,
            JobAuditKind.PaymentVoided when parts.Length == 2 => L["Payment of {0} EGP voided", parts[0]].Value,
            JobAuditKind.Assigned => string.IsNullOrEmpty(entry.Detail) ? L["Unassigned"].Value : L["Assigned to {0}", entry.Detail].Value,
            JobAuditKind.PartUsed when parts.Length == 2 => L["{0} x {1} taken from stock", parts[1], parts[0]].Value,
            JobAuditKind.PartReturned when parts.Length == 2 => L["{0} x {1} put back in stock", parts[1], parts[0]].Value,
            _ => entry.Kind.ToString(),
        };
    }
}
<section class="panel panel-pad mt-3 mt-lg-4" aria-labelledby="history-heading">
    <details data-job-history>
        <summary class="panel-title" id="history-heading" style="cursor: pointer">@L["History"] <span class="chip">@Model.Count</span></summary>
        @if (Model.Count == 0)
        {
            <p class="text-secondary small mt-3 mb-0">@L["No history yet."]</p>
        }
        else
        {
            <ul class="list-unstyled small mt-3 mb-0">
                @foreach (var entry in Model)
                {
                    <li class="py-2 border-bottom">
                        <div>@Describe(entry)</div>
                        <div class="text-secondary">
                            @(string.IsNullOrEmpty(entry.UserName) ? L["Someone"].Value : entry.UserName)
                            &middot; <span class="ltr num">@ShopClock.ToShopTime(entry.AtUtc).ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </details>
</section>
