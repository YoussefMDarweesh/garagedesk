@page "{id:int}"
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@model DetailsModel
@{
    var job = Model.Job;
    ViewData["Title"] = $"{L["Job card"]} #{job.Id}";
    var vehicle = job.Vehicle;
    var steps = new[] { JobStatus.Booked, JobStatus.InProgress, JobStatus.Done, JobStatus.Paid };
}

<nav class="mb-3">
    <a asp-page="Index" class="text-secondary text-decoration-none"><partial name="_Icon" model='"chevron-left"' /> @L["Job cards"]</a>
</nav>

<div class="page-head">
    <div>
        <h1 class="h2 fw-bold mb-1">
            @L["Job card"] <span class="ltr num">#@job.Id</span>@if (job.InvoiceLabel is not null) { <span class="chip chip-info ltr num">@job.InvoiceLabel</span> }
            <partial name="_StatusBadge" model="job.Status" />
        </h1>
        <p class="page-sub">
            <span class="ltr num">@job.DateIn.ToString("yyyy-MM-dd")</span> &middot; @vehicle?.Make @vehicle?.Model
        </p>
        @if (job.EstimateId is int estimateId)
        {
            <p class="small text-secondary mb-0"><a asp-page="/Estimates/Details" asp-route-id="@estimateId" data-from-estimate>@L["Created from an estimate"]</a></p>
        }
    </div>
    <div class="page-actions">
        <a class="btn @(job.IsLocked ? "btn-primary" : "btn-outline-secondary")" asp-page="Invoice" asp-route-id="@job.Id"><partial name="_Icon" model='"file-text"' />@L["Invoice / Print"]</a>
        @if (!job.IsLocked)
        {
            <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@job.Id"><partial name="_Icon" model='"edit"' />@L["Edit"]</a>
        }
    </div>
</div>

@* Server messages become toasts (site.js); without JavaScript they stay readable in place. *@
@if (Model.OfferShare && job.Status is JobStatus.Done or JobStatus.Paid)
{
    @* The job just reached Done: a toast with a button that opens the WhatsApp message (a POST, so the link is made
       on demand). Without JavaScript the plain text shows and the "Share with the customer" panel does the same. *@
    <div class="toast-source" data-toast="success" data-toast-action="#ready-share-form" data-toast-action-label="@L["Tell the customer on WhatsApp"]" role="status">@L["The car is ready."]</div>
    <form id="ready-share-form" method="post" asp-page-handler="Share" asp-route-id="@job.Id" asp-route-kind="@ShareLinkKind.Status" target="_blank" class="d-none"></form>
}
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="toast-source" data-toast="success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="toast-source" data-toast="danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.OfferReminder && job.Status == JobStatus.Done)
{
    // Suggest the next oil change: a few months from now, or a set distance past the vehicle's mileage.
    var suggestedDate = GarageDesk.Web.Services.ShopClock.Today().AddMonths(Reminder.SuggestedOilChangeMonths);
    var suggestedKm = Math.Max(job.MileageAtVisit, vehicle?.Mileage ?? 0) + Reminder.SuggestedOilChangeKm;
    <section class="panel panel-pad offer mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="icon-tile"><partial name="_Icon" model='"bell"' /></span>
                <div>
                    <h2 class="h6 mb-1">@L["Job done. Create the next oil change reminder?"]</h2>
                    <p class="text-secondary small mb-0">
                        @L["Suggested: {0} or {1} km. You can change both.", suggestedDate.ToString("yyyy-MM-dd"), suggestedKm.ToString("N0")]
                    </p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-primary btn-sm" asp-page="/Reminders/Create"
                   asp-route-vehicleId="@job.VehicleId"
                   asp-route-type="@L["Oil change"].Value"
                   asp-route-dueDate="@suggestedDate.ToString("yyyy-MM-dd")"
                   asp-route-dueMileage="@suggestedKm">@L["Create reminder"]</a>
                <a class="btn btn-outline-secondary btn-sm" asp-page="Details" asp-route-id="@job.Id">@L["Not now"]</a>
            </div>
        </div>
    </section>
}

<div class="row g-3 g-lg-4">
    <div class="col-lg-8">
        <section class="panel panel-pad" aria-labelledby="lines-heading">
            <div class="panel-head"><h2 id="lines-heading" class="panel-title">@L["Parts and labor"]</h2></div>

            @if (job.Lines.Count == 0)
            {
                <div class="empty">
                    <span class="icon-tile"><partial name="_Icon" model='"tool"' /></span>
                    <p>@L["No lines yet. Add the parts and labor below."]</p>
                </div>
            }
            else
            {
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th scope="col">@L["Type"]</th>
                                <th scope="col">@L["Description"]</th>
                                <th scope="col" class="cell-end">@L["Quantity"]</th>
                                <th scope="col" class="cell-end">@L["Unit price"]</th>
                                <th scope="col" class="cell-end">@L["Total"]</th>
                                @if (!job.IsLocked)
                                {
                                    <th scope="col"><span class="visually-hidden">@L["Remove"]</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in job.Lines)
                        {
                            <tr>
                                <td><span class="chip @(line.Type == JobLineType.Part ? "chip-info" : "chip-accent")">@(line.Type == JobLineType.Part ? L["Part"] : L["Labor"])</span></td>
                                <td class="fw-semibold">
                                    @line.Description
                                    @if (line.PartId is not null) { <span class="chip" data-from-stock>@L["From stock"]</span> }
                                    @if (Model.CanSeeProfit && line.UnitCost is decimal unitCost)
                                    {
                                        <div class="small text-secondary fw-normal" data-line-cost>@L["Cost"] <span class="ltr num">@MoneyFormat.Amount(unitCost)</span> @L["EGP"]</div>
                                    }
                                </td>
                                <td class="cell-end num"><span class="ltr">@line.Quantity.ToString("0.##")</span></td>
                                <td class="cell-end"><partial name="_Money" model="line.UnitPrice" /></td>
                                <td class="cell-end fw-bold"><partial name="_Money" model="line.LineTotal" /></td>
                                @if (!job.IsLocked)
                                {
                                    <td class="cell-end">
                                        <form method="post" asp-page-handler="RemoveLine" asp-route-id="@job.Id" asp-route-lineId="@line.Id"
                                              data-confirm="@L["Remove this line from the job card?"]">
                                            <button type="submit" class="icon-btn" title="@L["Remove"]" aria-label="@L["Remove"]"><partial name="_Icon" model='"x"' /></button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (!job.IsLocked)
            {
                <form method="post" asp-page-handler="AddLine" asp-route-id="@job.Id" novalidate class="add-line">
                    <h3 class="form-section-title">@L["Add a line"]</h3>
                    <div class="row g-2 align-items-start">
                        @if (Model.Parts.Count > 0)
                        {
                            <div class="col-12">
                                <label asp-for="NewLine.PartId" class="form-label small text-secondary"></label>
                                <select asp-for="NewLine.PartId" class="form-select" data-part-picker>
                                    <option value="">@L["Not from the catalog (free text)"]</option>
                                    @foreach (var part in Model.Parts)
                                    {
                                        <option value="@part.Id" data-name="@part.Name" data-price="@part.SellPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@part.Name (@part.Quantity.ToString("0.##") @part.Unit)</option>
                                    }
                                </select>
                                <div class="form-text">@L["Choosing a part takes it from stock and fills in its price."]</div>
                            </div>
                        }
                        <div class="col-sm-3 col-md-2">
                            <label asp-for="NewLine.Type" class="form-label small text-secondary"></label>
                            <select asp-for="NewLine.Type" class="form-select" data-part-type>
                                <option value="@JobLineType.Part">@L["Part"]</option>
                                <option value="@JobLineType.Labor">@L["Labor"]</option>
                            </select>
                        </div>
                        <div class="col-sm-9 col-md-4">
                            <label asp-for="NewLine.Description" class="form-label small text-secondary"></label>
                            <input asp-for="NewLine.Description" class="form-control" autocomplete="off" list="parts-list" data-part-description />
                            <datalist id="parts-list">
                                @foreach (var part in Model.Parts)
                                {
                                    <option value="@part.Name"></option>
                                }
                            </datalist>
                            <span asp-validation-for="NewLine.Description"></span>
                        </div>
                        <div class="col-6 col-md-2">
                            <label asp-for="NewLine.Quantity" class="form-label small text-secondary"></label>
                            <input asp-for="NewLine.Quantity" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" />
                            <span asp-validation-for="NewLine.Quantity"></span>
                        </div>
                        <div class="col-6 col-md-2">
                            <label asp-for="NewLine.UnitPrice" class="form-label small text-secondary"></label>
                            <input asp-for="NewLine.UnitPrice" type="number" step="0.01" min="0" inputmode="decimal" class="form-control" data-part-price />
                            <span asp-validation-for="NewLine.UnitPrice"></span>
                        </div>
                        <div class="col-12 col-md-2 d-grid">
                            <label class="form-label small d-none d-md-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary"><partial name="_Icon" model='"plus"' />@L["Add line"]</button>
                        </div>
                    </div>
                </form>
            }
        </section>
    </div>

    <div class="col-lg-4">
        <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="total-heading">
            <div class="panel-head"><h2 id="total-heading" class="panel-title">@L["Total"]</h2></div>
            <dl class="row mb-0 g-1">
                <dt class="col-6 text-secondary fw-normal">@L["Parts"]</dt>
                <dd class="col-6 text-end mb-1"><partial name="_Money" model="job.PartsTotal" /></dd>
                <dt class="col-6 text-secondary fw-normal">@L["Labor"]</dt>
                <dd class="col-6 text-end mb-2"><partial name="_Money" model="job.LaborTotal" /></dd>
                @if (job.DiscountValue > 0 || job.VatValue > 0)
                {
                    <dt class="col-6 text-secondary fw-normal">@L["Subtotal"]</dt>
                    <dd class="col-6 text-end mb-1"><partial name="_Money" model="job.Subtotal" /></dd>
                }
                @if (job.DiscountValue > 0)
                {
                    <dt class="col-6 text-secondary fw-normal">@L["Discount"]@(job.DiscountPercent is > 0 ? $" ({job.DiscountPercent:0.##}%)" : "")</dt>
                    <dd class="col-6 text-end mb-1" data-job-discount>&minus; <partial name="_Money" model="job.DiscountValue" /></dd>
                }
                @if (job.VatValue > 0)
                {
                    <dt class="col-6 text-secondary fw-normal">@L["VAT"] (<span class="ltr">@job.VatPercent?.ToString("0.##")%</span>)</dt>
                    <dd class="col-6 text-end mb-2" data-job-vat><partial name="_Money" model="job.VatValue" /></dd>
                }
                <dt class="col-6 border-top pt-3 mb-0">@L["Total"]</dt>
                <dd class="col-6 text-end border-top pt-3 mb-0 fw-bold fs-5" data-job-total><partial name="_Money" model="job.Total" /></dd>
            </dl>
        </section>

        @if (Model.CanSeeProfit)
        {
            @* Owner only: what the shop paid for the parts and what is left. Worked out from the lines, never stored. *@
            var partCost = GarageDesk.Web.Services.JobProfit.PartCost(job.Lines);
            var withoutCost = GarageDesk.Web.Services.JobProfit.PartLinesWithoutCost(job.Lines);
            <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="profit-heading" data-job-profit>
                <div class="panel-head"><h2 id="profit-heading" class="panel-title">@L["Profit on this job"]</h2><span class="chip">@L["Owner only"]</span></div>
                <dl class="row mb-2 g-1">
                    <dt class="col-6 text-secondary fw-normal">@L["Revenue (before VAT)"]</dt>
                    <dd class="col-6 text-end mb-1" data-profit-revenue><partial name="_Money" model="GarageDesk.Web.Services.JobProfit.Revenue(job)" /></dd>
                    <dt class="col-6 text-secondary fw-normal">@L["Part cost"]</dt>
                    <dd class="col-6 text-end mb-1" data-profit-cost>&minus; <partial name="_Money" model="partCost" /></dd>
                    <dt class="col-6 border-top pt-2 mb-0">@L["Profit"]</dt>
                    <dd class="col-6 text-end border-top pt-2 mb-0 fw-bold" data-profit-value><partial name="_Money" model="GarageDesk.Web.Services.JobProfit.Of(job)" /></dd>
                </dl>
                <p class="text-secondary small mb-0" title="@L["Profit = subtotal minus discount, minus the cost of the parts taken from stock. Labor has no cost. VAT is not income."]">
                    @L["Profit = subtotal minus discount, minus the cost of the parts taken from stock. Labor has no cost. VAT is not income."]
                    @if (withoutCost > 0)
                    {
                        <span data-profit-uncosted> @L["{0} part lines are free text, so their cost is not known.", withoutCost]</span>
                    }
                </p>
            </section>
        }

        <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="payments-heading">
            <div class="panel-head">
                <h2 id="payments-heading" class="panel-title">@L["Payments"]</h2>
                <span class="chip @(job.PaymentState == PaymentState.Paid ? "chip-ok" : job.PaymentState == PaymentState.Partial ? "chip-info" : "")" data-payment-state>
                    @(job.PaymentState switch { PaymentState.Paid => L["Paid in full"], PaymentState.Partial => L["Partly paid"], _ => L["Unpaid"] })
                </span>
            </div>
            <dl class="row mb-2 g-1">
                <dt class="col-6 text-secondary fw-normal">@L["Received"]</dt>
                <dd class="col-6 text-end mb-1"><partial name="_Money" model="job.PaidTotal" /></dd>
                <dt class="col-6 fw-bold">@L["Balance due"]</dt>
                <dd class="col-6 text-end fw-bold" data-job-balance><partial name="_Money" model="job.Balance" /></dd>
            </dl>
            @if (job.Payments.Count == 0)
            {
                <p class="text-secondary small mb-3">@L["No payments yet."]</p>
            }
            else
            {
                var latestId = job.Payments.Max(p => p.Id);
                <ul class="list-unstyled small mb-3">
                    @foreach (var p in job.Payments)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-2 py-1 border-bottom">
                            <span>
                                <span class="ltr num">@p.PaidOn.ToString("yyyy-MM-dd")</span> &middot;
                                @(p.Method switch { PaymentMethod.Card => L["Card"], PaymentMethod.BankTransfer => L["Bank transfer"], PaymentMethod.Wallet => L["Wallet"], _ => L["Cash"] })
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                <partial name="_Money" model="p.Amount" />
                                @if (!job.IsLocked && p.Id == latestId)
                                {
                                    <form method="post" asp-page-handler="VoidPayment" asp-route-id="@job.Id" asp-route-paymentId="@p.Id"
                                          data-confirm="@L["Void this payment?"]">
                                        <button type="submit" class="icon-btn" title="@L["Void payment"]" aria-label="@L["Void payment"]"><partial name="_Icon" model='"x"' /></button>
                                    </form>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
            @if (!job.IsLocked && job.Balance > 0)
            {
                <form method="post" asp-page-handler="AddPayment" asp-route-id="@job.Id" novalidate>
                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="NewPayment.Amount" class="form-label small text-secondary"></label>
                            <input asp-for="NewPayment.Amount" value="@job.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" max="@job.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" />
                        </div>
                        <div class="col-6">
                            <label asp-for="NewPayment.Method" class="form-label small text-secondary"></label>
                            <select asp-for="NewPayment.Method" class="form-select">
                                <option value="@PaymentMethod.Cash">@L["Cash"]</option>
                                <option value="@PaymentMethod.Card">@L["Card"]</option>
                                <option value="@PaymentMethod.BankTransfer">@L["Bank transfer"]</option>
                                <option value="@PaymentMethod.Wallet">@L["Wallet"]</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <input asp-for="NewPayment.Note" class="form-control" placeholder="@L["Note"]" autocomplete="off" />
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" class="btn btn-primary"><partial name="_Icon" model='"plus"' />@L["Add payment"]</button>
                        </div>
                    </div>
                </form>
            }
        </section>

        <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="status-heading">
            <div class="panel-head"><h2 id="status-heading" class="panel-title">@L["Status"]</h2></div>

            <ol class="stepper" aria-label="@L["Status"]">
                @foreach (var step in steps)
                {
                    var state = step == job.Status ? "current" : step < job.Status ? "done" : "";
                    <li class="@state" aria-current="@(step == job.Status ? "step" : null)">
                        <span class="step-dot">@if (step < job.Status) { <partial name="_Icon" model='"check"' /> }</span>
                        <span class="step-label"><partial name="_StatusLabel" model="step" /></span>
                    </li>
                }
            </ol>

            <div class="d-grid gap-2 mt-4">
                @if (Model.NextStatus is JobStatus next)
                {
                    <form method="post" asp-page-handler="Status" asp-route-id="@job.Id" asp-route-to="@next"
                          data-confirm="@(next == JobStatus.Paid ? L["Mark this job card as paid? A paid job card can no longer be changed."].Value : null)">
                        <button type="submit" class="btn btn-primary w-100">
                            @(next switch
                            {
                                JobStatus.InProgress => L["Start work"],
                                JobStatus.Done => L["Mark as done"],
                                _ => L["Mark as paid"],
                            })
                        </button>
                    </form>
                }
                @if (Model.PreviousStatus is JobStatus previous)
                {
                    <form method="post" asp-page-handler="Status" asp-route-id="@job.Id" asp-route-to="@previous">
                        <button type="submit" class="btn btn-outline-secondary w-100 btn-sm">
                            @L["Move back to"] <partial name="_StatusLabel" model="previous" />
                        </button>
                    </form>
                }
                @if (job.IsLocked)
                {
                    <p class="text-secondary small mb-0">@L["This job card is paid and can no longer be changed."]</p>
                }
            </div>
        </section>

        <section class="panel panel-pad mb-3 mb-lg-4" aria-labelledby="share-heading" data-share-panel>
            <div class="panel-head"><h2 id="share-heading" class="panel-title">@L["Share with the customer"]</h2></div>
            <p class="text-secondary small">@L["Send a private link on WhatsApp. The customer opens it without logging in and sees only this car."]</p>
            <div class="d-grid gap-2 mb-3">
                <form method="post" asp-page-handler="Share" asp-route-id="@job.Id" asp-route-kind="@ShareLinkKind.Status" target="_blank">
                    <button type="submit" class="btn btn-primary w-100" data-share-whatsapp="status"><partial name="_Icon" model='"whatsapp"' />@L["Send status on WhatsApp"]</button>
                </form>
                <form method="post" asp-page-handler="Share" asp-route-id="@job.Id" asp-route-kind="@ShareLinkKind.Invoice" target="_blank">
                    <button type="submit" class="btn btn-outline-secondary w-100" data-share-whatsapp="invoice"><partial name="_Icon" model='"whatsapp"' />@L["Send invoice on WhatsApp"]</button>
                </form>
                <div class="d-flex gap-2">
                    <form method="post" asp-page-handler="CreateLink" asp-route-id="@job.Id" asp-route-kind="@ShareLinkKind.Status" class="flex-fill">
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100" data-create-link="status">@L["Get status link"]</button>
                    </form>
                    <form method="post" asp-page-handler="CreateLink" asp-route-id="@job.Id" asp-route-kind="@ShareLinkKind.Invoice" class="flex-fill">
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100" data-create-link="invoice">@L["Get invoice link"]</button>
                    </form>
                </div>
            </div>
            <partial name="_ShareLinks" model="Model.Links" />
        </section>

        <section class="panel panel-pad" aria-labelledby="details-heading">
            <div class="panel-head"><h2 id="details-heading" class="panel-title">@L["Details"]</h2></div>
            <dl class="mb-0">
                <dt class="text-secondary fw-normal">@L["Vehicle"]</dt>
                <dd>
                    <a class="plate" asp-page="/Vehicles/Details" asp-route-id="@job.VehicleId">@PlateFormat.Html(vehicle?.Plate)</a>
                    <span class="ms-1">@vehicle?.Make @vehicle?.Model</span>
                </dd>
                <dt class="text-secondary fw-normal">@L["Owner"]</dt>
                <dd>
                    @if (vehicle?.Customer is { } owner)
                    {
                        <span class="identity">
                            <partial name="_Avatar" model="owner.Name" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-sm" }' />
                            <a asp-page="/Customers/Details" asp-route-id="@vehicle.CustomerId">@owner.Name</a>
                        </span>
                    }
                </dd>
                <dt class="text-secondary fw-normal">@L["Assigned to"]</dt>
                <dd data-assigned-to>@if (job.AssignedTo is { } assignee) { @assignee.DisplayLabel } else { <span class="text-secondary">@L["Not assigned"]</span> }</dd>
                <dt class="text-secondary fw-normal">@L["Mileage at visit (km)"]</dt>
                <dd class="num"><span class="ltr">@job.MileageAtVisit.ToString("N0")</span></dd>
                @if (!string.IsNullOrWhiteSpace(job.Notes))
                {
                    <dt class="text-secondary fw-normal">@L["Notes"]</dt>
                    <dd class="mb-0" style="white-space: pre-line">@job.Notes</dd>
                }
            </dl>
        </section>

        @if (Model.CanSeeHistory)
        {
            <partial name="_JobHistory" model="Model.History" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
