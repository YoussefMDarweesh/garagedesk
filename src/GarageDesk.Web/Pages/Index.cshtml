@page
@using System.Globalization
@using GarageDesk.Web.Models
@using GarageDesk.Web.Services
@model IndexModel
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = Model.ShopName ?? (signedIn ? L["Home"].Value : L["Workshop manager for small car service shops"].Value);
    if (!signedIn)
    {
        ViewData["Description"] = L["Job cards, invoices, reminders and WhatsApp links for small car service shops. Arabic and English, on your phone."].Value;
    }
}

@if (!signedIn)
{
    @* Visitors get the public landing page: the same for everyone, nothing about any shop (see _Landing.cshtml). *@
    <partial name="_Landing" />
}
else
{
    var arabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var dateText = Model.Today.ToString("dddd d MMMM yyyy", new CultureInfo(arabic ? "ar-EG" : "en-GB"));
    var greeting = Model.DayPart switch
    {
        "morning" => L["Good morning, {0}", Model.GreetingName].Value,
        "afternoon" => L["Good afternoon, {0}", Model.GreetingName].Value,
        _ => L["Good evening, {0}", Model.GreetingName].Value,
    };
    var waiting = Model.OverdueReminderCount + Model.ReadyForPickupCount + (Model.OutstandingTotal > 0 ? 1 : 0);

    @* ------------------------------------------------ today at the shop ------------------------------------------------ *@
    <section class="hero" aria-labelledby="hero-title" data-hero>
        <div class="hero-main">
            <p class="hero-date"><span class="ltr">@dateText</span></p>
            <h1 id="hero-title">@L["Today at {0}", Model.ShopName ?? L["Welcome"].Value]</h1>
            <p class="hero-sub">@greeting. @(waiting > 0 ? L["Here is what needs you now."] : L["Nothing is waiting on you right now."])</p>
            <div class="hero-actions">
                <a class="btn btn-primary" asp-page="/Jobs/Create"><partial name="_Icon" model='"plus"' />@L["New job card"]</a>
                <a class="btn btn-hero" asp-page="/Customers/Create"><partial name="_Icon" model='"plus"' />@L["Add customer"]</a>
                <a class="btn btn-hero" asp-page="/Estimates/Create"><partial name="_Icon" model='"plus"' />@L["New estimate"]</a>
            </div>
        </div>
        <ul class="hero-chips" aria-label="@L["Needs attention"]">
            <li>
                <a class="attn @(Model.InShopCount > 0 ? "attn-accent" : "attn-calm")" asp-page="/Jobs/Index" asp-route-status="InProgress" data-attn="in-shop">
                    <span class="attn-icon"><partial name="_Icon" model='"tool"' /></span>
                    <span class="attn-num num">@Model.InShopCount</span>
                    <span class="attn-label">@L["Cars in the shop"]</span>
                </a>
            </li>
            <li>
                <a class="attn @(Model.ReadyForPickupCount > 0 ? "attn-info" : "attn-calm")" asp-page="/Jobs/Index" asp-route-status="Done" data-attn="ready">
                    <span class="attn-icon"><partial name="_Icon" model='"check-circle"' /></span>
                    <span class="attn-num num">@Model.ReadyForPickupCount</span>
                    <span class="attn-label">@L["Ready for pickup"]</span>
                </a>
            </li>
            <li>
                <a class="attn @(Model.OverdueReminderCount > 0 ? "attn-bad" : "attn-calm")" asp-page="/Reminders/Index" data-attn="overdue">
                    <span class="attn-icon"><partial name="_Icon" model='"bell"' /></span>
                    <span class="attn-num num">@Model.OverdueReminderCount</span>
                    <span class="attn-label">@L["Overdue reminders"]</span>
                </a>
            </li>
            <li>
                <a class="attn @(Model.OutstandingTotal > 0 ? "attn-warn" : "attn-calm")" asp-page="/Receivables/Index" data-attn="collect">
                    <span class="attn-icon"><partial name="_Icon" model='"coins"' /></span>
                    <span class="attn-num attn-money"><span class="ltr num">@MoneyFormat.Amount(Model.OutstandingTotal)</span><small>@L["EGP"]</small></span>
                    <span class="attn-label">@L["Money to collect"]</span>
                </a>
            </li>
        </ul>
    </section>

    @* Derived from the shop's real data on every request (see SetupProgress), so it survives a refresh. *@
    @if (!Model.Setup.CoreDone)
    {
        <partial name="_SetupChecklist" model="new SetupChecklistModel(Model.Setup, Model.CanSeeReports)" />
    }

    @* ---- the money that matters: big, with the currency on the same line as the number ---- *@
    <div class="kpi-row" data-kpi-row>
        @if (Model.CanSeeReports)
        {
        <a class="kpi" asp-page="/Jobs/Index" asp-route-status="Paid" data-kpi="revenue">
            <div class="stat-top"><span class="stat-label">@L["Revenue this month"]</span><span class="icon-tile"><partial name="_Icon" model='"coins"' /></span></div>
            <p class="kpi-value stat-value"><span class="ltr">@MoneyFormat.Amount(Model.RevenueThisMonth)</span> <small class="stat-unit">@L["EGP"]</small></p>
            <div class="kpi-foot">
                <p class="stat-sub">
                    @if (Model.RevenueChangePercent is int change)
                    {
                        <partial name="_Trend" model="change" />
                        @L["vs last month"]
                    }
                    else
                    {
                        @L["From {0} paid job cards", Model.PaidThisMonthCount]
                    }
                </p>
                @if (Model.RevenueSpark is { } revenueSpark) { <partial name="_Spark" model="revenueSpark" /> }
            </div>
        </a>
        <a class="kpi" asp-page="/Money/Profit" data-profit-card data-kpi="profit" title="@L["Payments received this month, minus expenses paid this month."]">
            <div class="stat-top"><span class="stat-label">@L["Profit this month"]</span><span class="icon-tile"><partial name="_Icon" model='"trending-up"' /></span></div>
            <p class="kpi-value stat-value @(Model.ProfitThisMonth < 0 ? "figure-negative" : "")" data-profit><span class="ltr">@MoneyFormat.Amount(Model.ProfitThisMonth)</span> <small class="stat-unit">@L["EGP"]</small></p>
            <div class="kpi-foot">
                <p class="stat-sub">
                    @if (Model.ProfitChangePercent is int profitChange)
                    {
                        <partial name="_Trend" model="profitChange" />
                        @L["vs last month"]
                    }
                    else
                    {
                        @L["Cash basis: received minus expenses"]
                    }
                </p>
                @if (Model.ProfitSpark is { } profitSpark) { <partial name="_Spark" model="profitSpark" /> }
            </div>
        </a>
        }
        <a class="kpi" asp-page="/Receivables/Index" data-kpi="outstanding">
            <div class="stat-top"><span class="stat-label">@L["Outstanding"]</span><span class="icon-tile"><partial name="_Icon" model='"alert"' /></span></div>
            <p class="kpi-value stat-value" data-outstanding><span class="ltr">@MoneyFormat.Amount(Model.OutstandingTotal)</span> <small class="stat-unit">@L["EGP"]</small></p>
            <div class="kpi-foot">
                <p class="stat-sub">
                    @L["Unpaid job cards"]: <span class="ltr num">@Model.OutstandingCustomers</span>
                    @if (Model.OutstandingOldestDays is int oldest && oldest > 0)
                    {
                        <span class="stat-dot" aria-hidden="true">&middot;</span> @L["oldest {0} days", oldest]
                    }
                </p>
            </div>
        </a>
        @if (!Model.CanSeeReports)
        {
        <a class="kpi" asp-page="/Jobs/Index">
            <div class="stat-top"><span class="stat-label">@L["Open job cards"]</span><span class="icon-tile"><partial name="_Icon" model='"clipboard"' /></span></div>
            <p class="kpi-value stat-value">@Model.OpenJobCount</p>
            <div class="kpi-foot"><p class="stat-sub">@L["{0} booked · {1} in progress · {2} done", Model.BookedCount, Model.InProgressCount, Model.DoneCount]</p></div>
        </a>
        }
    </div>

    @* ---- the counts: quieter, one line each ---- *@
    <div class="stat-row">
        @if (Model.CanSeeReports)
        {
        <a class="stat-card stat-compact" asp-page="/Jobs/Index">
            <span class="icon-tile"><partial name="_Icon" model='"clipboard"' /></span>
            <div class="min-w-0">
                <span class="stat-label">@L["Open job cards"]</span>
                <p class="stat-value">@Model.OpenJobCount</p>
                <p class="stat-sub">@L["{0} booked · {1} in progress · {2} done", Model.BookedCount, Model.InProgressCount, Model.DoneCount]</p>
            </div>
        </a>
        }
        <a class="stat-card stat-compact" asp-page="/Customers/Index">
            <span class="icon-tile"><partial name="_Icon" model='"users"' /></span>
            <div class="min-w-0">
                <span class="stat-label">@L["Customers"]</span>
                <p class="stat-value">@Model.CustomerCount</p>
                <p class="stat-sub">@L["Registered in your shop"]</p>
            </div>
        </a>
        <a class="stat-card stat-compact" asp-page="/Vehicles/Index">
            <span class="icon-tile"><partial name="_Icon" model='"car"' /></span>
            <div class="min-w-0">
                <span class="stat-label">@L["Vehicles"]</span>
                <p class="stat-value">@Model.VehicleCount</p>
                <p class="stat-sub">@L["Across {0} customers", Model.CustomerCount]</p>
            </div>
        </a>
        @if (Model.Stock.PartCount > 0)
        {
        <a class="stat-card stat-compact @(Model.Stock.LowCount > 0 ? "stat-warn" : "")" asp-page="/Parts/Index" asp-route-show="@(Model.Stock.LowCount > 0 ? "low" : null)" data-stock-card>
            <span class="icon-tile"><partial name="_Icon" model='"package"' /></span>
            <div class="min-w-0">
                <span class="stat-label">@L["Running low"]</span>
                <p class="stat-value" data-low-count>@Model.Stock.LowCount</p>
                <p class="stat-sub">
                    @if (Model.Stock.StockValue is decimal stockValue)
                    {
                        <span data-stock-value>@L["Stock value (at cost)"]: <span class="ltr num">@MoneyFormat.Amount(stockValue)</span> @L["EGP"]</span>
                    }
                    else if (Model.Stock.LowNames.Count > 0)
                    {
                        @string.Join(", ", Model.Stock.LowNames)
                    }
                    else
                    {
                        @L["Parts at or below their alert level"]
                    }
                </p>
            </div>
        </a>
        }
    </div>

    <div class="row g-3 g-lg-4 mb-4">
        @if (Model.CanSeeReports)
        {
        <div class="col-xl-8">
            <section class="panel panel-pad h-100" aria-labelledby="activity-heading">
                <div class="panel-head">
                    <div>
                        <h2 id="activity-heading" class="panel-title">@L["Activity"]</h2>
                        @if (Model.HasChartData)
                        {
                            <p class="panel-sub">
                                <span class="ltr num">@MoneyFormat.Amount(Model.YearRevenue)</span> @L["EGP"] <span class="stat-dot" aria-hidden="true">&middot;</span>
                                @L["{0} job cards in {1} months", Model.YearJobs, Model.Months.Count]
                            </p>
                        }
                    </div>
                    @if (Model.HasChartData)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            <div class="range-pills" role="group" aria-label="@L["What to chart"]" data-chart-controls>
                                <button type="button" data-metric="revenue" aria-pressed="true">@L["Revenue"]</button>
                                <button type="button" data-metric="jobs" aria-pressed="false">@L["Job cards"]</button>
                            </div>
                            <div class="range-pills" role="group" aria-label="@L["Time range"]">
                                <button type="button" data-range="3" aria-pressed="false">@L["3M"]</button>
                                <button type="button" data-range="6" aria-pressed="false">@L["6M"]</button>
                                <button type="button" data-range="12" aria-pressed="true">@L["1Y"]</button>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.HasChartData)
                {
                    <div data-chart data-currency="@L["EGP"]" data-label-revenue="@L["Revenue"]" data-label-jobs="@L["Job cards"]">
                        <div class="chart-wrap" dir="ltr">
                            <div class="chart-canvas" tabindex="0" aria-label="@L["Activity chart. Use the left and right arrow keys to move between months."]">
                                <div class="skeleton" style="height: 17rem"></div>
                            </div>
                            <div class="chart-tip" aria-hidden="true"></div>
                        </div>
                        <script type="application/json">@Html.Raw(Model.ChartJson)</script>
                        <table class="visually-hidden">
                            <caption>@L["Revenue and job cards by month"]</caption>
                            <thead><tr><th>@L["Month"]</th><th>@L["Revenue"]</th><th>@L["Job cards"]</th></tr></thead>
                            <tbody>
                                @foreach (var month in Model.Months)
                                {
                                    <tr><td>@month.Key</td><td>@MoneyFormat.Amount(month.Revenue)</td><td>@month.Jobs</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty">
                        <span class="icon-tile"><partial name="_Icon" model='"trending-up"' /></span>
                        <h3>@L["Your activity will show up here"]</h3>
                        <p>@L["Open a few job cards and this chart fills in with your revenue and workload by month."]</p>
                        <a class="btn btn-primary btn-sm mt-2" asp-page="@(Model.VehicleCount > 0 ? "/Jobs/Create" : "/Customers/Create")">
                            @(Model.VehicleCount > 0 ? L["New job card"] : L["Add customer"])
                        </a>
                    </div>
                }
            </section>
        </div>
        }

        <div class="@(Model.CanSeeReports ? "col-xl-4" : "col-xl-12")">
            <section class="panel h-100" aria-labelledby="due-heading">
                <div class="panel-pad pb-0">
                    <div class="panel-head mb-2">
                        <h2 id="due-heading" class="panel-title">@L["Reminders due"]</h2>
                        <a class="small fw-bold" asp-page="/Reminders/Index">@L["See all reminders"]</a>
                    </div>
                </div>

                @if (Model.DueReminders.Count == 0)
                {
                    <div class="empty">
                        <span class="icon-tile"><partial name="_Icon" model='"check-circle"' /></span>
                        <h3>@L["All caught up"]</h3>
                        <p>@L["Nothing is due in the next 14 days. Nice work."]</p>
                        <a class="btn btn-outline-secondary btn-sm mt-2" asp-page="/Reminders/Create">@L["Add reminder"]</a>
                    </div>
                }
                else
                {
                    var dashboardReturn = Url.Page("/Index");
                    <ul class="list-group list-group-flush">
                        @foreach (var reminder in Model.DueReminders)
                        {
                            <partial name="_ReminderRow" model="new GarageDesk.Web.Pages.Reminders.ReminderRowModel(reminder, Model.Today, dashboardReturn!, Model.ReminderShopName, Compact: true)" />
                        }
                    </ul>
                }
            </section>
        </div>
    </div>

    <div class="row g-3 g-lg-4">
        <div class="col-xl-8">
            <section class="panel panel-pad h-100" aria-labelledby="history-heading">
                <div class="panel-head">
                    <h2 id="history-heading" class="panel-title">@L["Recent service history"]</h2>
                    <a class="small fw-bold" asp-page="/Jobs/Index">@L["All job cards"]</a>
                </div>

                @if (Model.RecentJobs.Count == 0)
                {
                    <div class="empty">
                        <span class="icon-tile"><partial name="_Icon" model='"clock"' /></span>
                        <h3>@L["No service history yet"]</h3>
                        <p>@L["Every job card you open appears here, newest first."]</p>
                        <a class="btn btn-primary btn-sm mt-2" asp-page="/Jobs/Create">@L["New job card"]</a>
                    </div>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var job in Model.RecentJobs)
                        {
                            var dot = job.Status switch
                            {
                                JobStatus.Paid => "ok",
                                JobStatus.Done => "info",
                                JobStatus.InProgress => "accent",
                                _ => "",
                            };
                            var icon = job.Status switch
                            {
                                JobStatus.Paid => "check",
                                JobStatus.Done => "check-circle",
                                JobStatus.InProgress => "tool",
                                _ => "calendar",
                            };
                            var summary = job.Lines.Count == 0
                                ? $"{L["Job card"]} #{job.Id}"
                                : string.Join(", ", job.Lines.Take(2).Select(l => l.Description))
                                  + (job.Lines.Count > 2 ? $" +{job.Lines.Count - 2}" : "");
                            <li>
                                <span class="tl-dot @dot"><partial name="_Icon" model="icon" /></span>
                                <div class="min-w-0">
                                    <p class="tl-title"><a class="text-reset" asp-page="/Jobs/Details" asp-route-id="@job.Id">@summary</a></p>
                                    <p class="tl-meta">
                                        <span class="plate">@PlateFormat.Html(job.Vehicle?.Plate)</span>
                                        @job.Vehicle?.Make @job.Vehicle?.Model &middot; @job.Vehicle?.Customer?.Name
                                    </p>
                                </div>
                                <div class="tl-aside">
                                    <partial name="_StatusBadge" model="job.Status" />
                                    <p class="tl-meta mb-0"><span class="ltr">@job.DateIn.ToString("yyyy-MM-dd")</span> &middot; <partial name="_Money" model="job.Total" /></p>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <div class="col-xl-4">
            <section class="panel panel-pad h-100" aria-labelledby="quick-heading">
                <div class="panel-head"><h2 id="quick-heading" class="panel-title">@L["Quick actions"]</h2></div>
                <div class="quick-actions">
                    <a class="quick-action" asp-page="/Jobs/Create"><span class="icon-tile"><partial name="_Icon" model='"clipboard"' /></span>@L["New job card"]</a>
                    <a class="quick-action" asp-page="/Customers/Create"><span class="icon-tile"><partial name="_Icon" model='"users"' /></span>@L["Add customer"]</a>
                    <a class="quick-action" asp-page="/Vehicles/Create"><span class="icon-tile"><partial name="_Icon" model='"car"' /></span>@L["Add vehicle"]</a>
                    <a class="quick-action" asp-page="/Reminders/Create"><span class="icon-tile"><partial name="_Icon" model='"bell"' /></span>@L["Add reminder"]</a>
                </div>
            </section>
        </div>
    </div>
}
