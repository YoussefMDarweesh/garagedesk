@page
@model IndexModel
@{
    ViewData["Title"] = Model.ShopName ?? "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="mb-5">
        <p class="eyebrow mb-1">Your shop</p>
        <h1 class="display-6 fw-bold">@(Model.ShopName ?? "Welcome")</h1>
        <p class="text-secondary mb-0">Your shop is set up and ready.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Getting started</h2>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    Create your account
                    <span class="badge text-bg-success">Done</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    Set up your shop
                    <span class="badge text-bg-success">Done</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-secondary">
                    Add your first customer and car
                    <span class="badge text-bg-light border text-secondary">Coming soon</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-secondary">
                    Open your first job card
                    <span class="badge text-bg-light border text-secondary">Coming soon</span>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    <section class="text-center py-4 py-md-5">
        <p class="eyebrow">For small car service shops</p>
        <h1 class="display-5 fw-bold mb-3">One place for every job, car and customer.</h1>
        <p class="lead text-secondary narrow mx-auto">
            Replace paper job cards, WhatsApp scrolling and Excel sheets with a simple workshop manager.
            Know what was done, what it cost, and when each car is due back.
        </p>
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Create your shop</a>
            <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        </div>
    </section>

    <section class="pt-5 mt-4 border-top">
        <h2 class="h4 text-center mb-4">What GarageDesk does</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Shop accounts <span class="badge text-bg-success align-self-start">Available</span></h3>
                    <p class="text-secondary mb-0">Every shop is its own private space. One shop never sees another shop's data.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Customers &amp; vehicles <span class="badge text-bg-light border text-secondary align-self-start">Coming soon</span></h3>
                    <p class="text-secondary mb-0">Find any customer or car in seconds by name, phone or plate number.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Job cards <span class="badge text-bg-light border text-secondary align-self-start">Coming soon</span></h3>
                    <p class="text-secondary mb-0">Parts and labor lines with totals worked out for you, from booked to paid.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Service history <span class="badge text-bg-light border text-secondary align-self-start">Coming soon</span></h3>
                    <p class="text-secondary mb-0">Every visit for a car, newest first, with mileage and what was done.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Reminders <span class="badge text-bg-light border text-secondary align-self-start">Coming soon</span></h3>
                    <p class="text-secondary mb-0">See who is due or overdue and message them on WhatsApp in one tap.</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between">Invoices <span class="badge text-bg-light border text-secondary align-self-start">Coming soon</span></h3>
                    <p class="text-secondary mb-0">Clean A4 invoices in EGP, ready to print or save as PDF.</p>
                </div></div>
            </div>
        </div>
    </section>
}
