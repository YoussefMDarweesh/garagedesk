@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome@(Model.ShopName is null ? "" : $" to {Model.ShopName}")</h1>
    @if (Model.ShopName is null)
    {
        <p>A simple workshop manager for small car service shops.</p>
    }
    else
    {
        <p>Your shop is set up. Customers, vehicles and job cards are coming next.</p>
    }
</div>
