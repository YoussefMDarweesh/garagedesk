@page
@using GarageDesk.Web.Services
@model IndexModel
@{
    ViewData["Title"] = Model.ShopName ?? L["Home"].Value;
}

@if (User.Identity?.IsAuthenticated == true)
{
    var logoVersion = User.FindFirst(CurrentShop.LogoClaimType)?.Value;
    <div class="mb-5 d-flex align-items-center gap-3">
        @if (logoVersion is not null)
        {
            <img src="@Url.Content("~" + ShopLogoEndpoint.Path)?v=@logoVersion" alt="@Model.ShopName" class="shop-logo shop-logo-lg" />
        }
        <div>
            <p class="eyebrow mb-1">@L["Your shop"]</p>
            <h1 class="display-6 fw-bold">@(Model.ShopName ?? L["Welcome"].Value)</h1>
            <p class="text-secondary mb-0">@L["Your shop is set up and ready."]</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6">
            <a class="card h-100 text-decoration-none" asp-page="/Customers/Index">
                <div class="card-body p-4">
                    <p class="text-secondary mb-1">@L["Customers"]</p>
                    <p class="display-6 fw-bold mb-0 text-body">@Model.CustomerCount</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6">
            <a class="card h-100 text-decoration-none" asp-page="/Vehicles/Index">
                <div class="card-body p-4">
                    <p class="text-secondary mb-1">@L["Vehicles"]</p>
                    <p class="display-6 fw-bold mb-0 text-body">@Model.VehicleCount</p>
                </div>
            </a>
        </div>
    </div>

    var firstCustomerAndCarDone = Model.CustomerCount > 0 && Model.VehicleCount > 0;
    <div class="card">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">@L["Getting started"]</h2>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    @L["Create your account"]
                    <span class="badge text-bg-success">@L["Done"]</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    @L["Set up your shop"]
                    <span class="badge text-bg-success">@L["Done"]</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    @if (firstCustomerAndCarDone)
                    {
                        <span>@L["Add your first customer and car"]</span>
                        <span class="badge text-bg-success">@L["Done"]</span>
                    }
                    else
                    {
                        <a asp-page="/Customers/Create">@L["Add your first customer and car"]</a>
                        <span class="badge bg-body-secondary border text-secondary">@L["To do"]</span>
                    }
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-secondary">
                    @L["Open your first job card"]
                    <span class="badge bg-body-secondary border text-secondary">@L["Coming soon"]</span>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    <section class="text-center py-4 py-md-5">
        <p class="eyebrow">@L["For small car service shops"]</p>
        <h1 class="display-5 fw-bold mb-3">@L["One place for every job, car and customer."]</h1>
        <p class="lead text-secondary narrow mx-auto">
            @L["Replace paper job cards, WhatsApp scrolling and Excel sheets with a simple workshop manager. Know what was done, what it cost, and when each car is due back."]
        </p>
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">@L["Create your shop"]</a>
            <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">@L["Log in"]</a>
        </div>
    </section>

    <section class="pt-5 mt-4 border-top">
        <h2 class="h4 text-center mb-4">@L["What GarageDesk does"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Shop accounts"] <span class="badge text-bg-success align-self-start">@L["Available"]</span></h3>
                    <p class="text-secondary mb-0">@L["Every shop is its own private space. One shop never sees another shop's data."]</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Customers & vehicles"] <span class="badge bg-body-secondary border text-secondary align-self-start">@L["Coming soon"]</span></h3>
                    <p class="text-secondary mb-0">@L["Find any customer or car in seconds by name, phone or plate number."]</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Job cards"] <span class="badge bg-body-secondary border text-secondary align-self-start">@L["Coming soon"]</span></h3>
                    <p class="text-secondary mb-0">@L["Parts and labor lines with totals worked out for you, from booked to paid."]</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Service history"] <span class="badge bg-body-secondary border text-secondary align-self-start">@L["Coming soon"]</span></h3>
                    <p class="text-secondary mb-0">@L["Every visit for a car, newest first, with mileage and what was done."]</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Reminders"] <span class="badge bg-body-secondary border text-secondary align-self-start">@L["Coming soon"]</span></h3>
                    <p class="text-secondary mb-0">@L["See who is due or overdue and message them on WhatsApp in one tap."]</p>
                </div></div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100"><div class="card-body p-4">
                    <h3 class="h6 d-flex justify-content-between gap-2">@L["Invoices"] <span class="badge bg-body-secondary border text-secondary align-self-start">@L["Coming soon"]</span></h3>
                    <p class="text-secondary mb-0">@L["Clean A4 invoices in EGP, ready to print or save as PDF."]</p>
                </div></div>
            </div>
        </div>
    </section>
}
