@page "{id:int}"
@using GarageDesk.Web.Services
@model DetailsModel
@{
    var customer = Model.Customer;
    ViewData["Title"] = customer.Name;
}

<nav class="mb-3">
    <a asp-page="Index" class="text-secondary text-decoration-none"><partial name="_Icon" model='"chevron-left"' /> @L["Customers"]</a>
</nav>

<section class="panel panel-pad mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="identity">
            <partial name="_Avatar" model="customer.Name" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-lg" }' />
            <div>
                <h1 class="h3 fw-bold mb-1">@customer.Name</h1>
                <p class="mb-0 text-secondary"><partial name="_Icon" model='"phone"' /> <span class="ltr num">@customer.Phone</span></p>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@customer.Id"><partial name="_Icon" model='"edit"' />@L["Edit"]</a>
            <a class="btn btn-primary" asp-page="/Vehicles/Create" asp-route-customerId="@customer.Id"><partial name="_Icon" model='"plus"' />@L["Add vehicle"]</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(customer.Notes))
    {
        <div class="mt-4 pt-4 border-top">
            <p class="form-section-title mb-1">@L["Notes"]</p>
            <p class="mb-0" style="white-space: pre-line">@customer.Notes</p>
        </div>
    }
</section>

<div class="panel-head">
    <h2 class="panel-title">@L["Vehicles"]</h2>
</div>

@if (customer.Vehicles.Count == 0)
{
    <section class="panel">
        <div class="empty">
            <span class="icon-tile"><partial name="_Icon" model='"car"' /></span>
            <h2>@L["No vehicles yet."]</h2>
            <p>@L["This customer has no vehicles yet."]</p>
            <a class="btn btn-primary btn-sm mt-2" asp-page="/Vehicles/Create" asp-route-customerId="@customer.Id">@L["Add vehicle"]</a>
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Plate number"]</th>
                        <th scope="col">@L["Vehicle"]</th>
                        <th scope="col">@L["Year"]</th>
                        <th scope="col" class="cell-end">@L["Mileage (km)"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var vehicle in customer.Vehicles)
                {
                    <tr>
                        <td><a class="plate" dir="auto" asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Plate</a></td>
                        <td class="fw-semibold">@vehicle.Make @vehicle.Model</td>
                        <td class="num">@vehicle.Year</td>
                        <td class="cell-end num">@vehicle.Mileage.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
