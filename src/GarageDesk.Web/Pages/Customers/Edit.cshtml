@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = L["Edit customer"].Value;
}

<div class="card shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-4">@L["Edit customer"]</h1>

        <form method="post" novalidate>
            <partial name="_CustomerForm" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.CustomerId">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
