@page
@model IndexModel
@inject GarageDesk.Web.Services.ICurrentStaff CurrentStaff
@{
    ViewData["Title"] = L["Customers"].Value;
    var isOwner = (await CurrentStaff.GetAsync())?.IsOwner == true; // bulk import is for owners
    var searching = !string.IsNullOrWhiteSpace(Model.Q);
}

<div class="page-head">
    <div>
        <h1 class="visually-hidden">@L["Customers"]</h1>
        <p class="page-sub mt-0">@L["{0} customers", Model.Total]</p>
    </div>
    <div class="page-actions">
        @if (isOwner)
        {
            <a class="btn btn-outline-secondary" asp-page="/Import">@L["Import customers and cars"]</a>
        }
        <a class="btn btn-primary" asp-page="Create"><partial name="_Icon" model='"plus"' />@L["Add customer"]</a>
    </div>
</div>

<form method="get" class="toolbar" role="search">
    <div class="search-field">
        <partial name="_Icon" model='"search"' />
        <input type="search" name="q" value="@Model.Q" class="form-control"
               placeholder="@L["Search by name, phone or plate number"]" aria-label="@L["Search by name, phone or plate number"]" />
    </div>
    <div class="page-actions">
        <button type="submit" class="btn btn-outline-secondary">@L["Search"]</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-page="Index">@L["Clear"]</a>
        }
    </div>
</form>

@if (Model.Customers.Count == 0)
{
    <section class="panel">
        <div class="empty">
            <span class="icon-tile"><partial name="_Icon" model='searching ? "search" : "users"' /></span>
            @if (searching)
            {
                <h2>@L["No customers match your search."]</h2>
                <p>@L["Try a different name, phone number or plate."]</p>
            }
            else
            {
                <h2>@L["No customers yet."]</h2>
                <p>@L["Add your first customer to get started."]</p>
                <a class="btn btn-primary mt-2" asp-page="Create">@L["Add customer"]</a>
            }
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Name"]</th>
                        <th scope="col">@L["Phone"]</th>
                        <th scope="col">@L["Vehicles"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td>
                            <div class="identity">
                                <partial name="_Avatar" model="customer.Name" />
                                <a class="identity-name" asp-page="Details" asp-route-id="@customer.Id">@customer.Name</a>
                            </div>
                        </td>
                        <td><span class="ltr num">@customer.Phone</span></td>
                        <td>
                            @if (customer.Vehicles.Count == 0)
                            {
                                <span class="text-secondary">&mdash;</span>
                            }
                            @foreach (var vehicle in customer.Vehicles)
                            {
                                var matched = Model.PlateKey.Length > 0 && vehicle.PlateKey.Contains(Model.PlateKey);
                                <a class="plate @(matched ? "plate-match" : "")" dir="auto"
                                   asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Plate</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <partial name="_Pager" model="Model.Pager" />
}
