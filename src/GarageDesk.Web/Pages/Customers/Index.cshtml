@page
@model IndexModel
@{
    ViewData["Title"] = L["Customers"].Value;
    var searching = !string.IsNullOrWhiteSpace(Model.Q);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h2 fw-bold mb-0">@L["Customers"]</h1>
    <a class="btn btn-primary" asp-page="Create">@L["Add customer"]</a>
</div>

<form method="get" class="mb-4" role="search">
    <div class="input-group">
        <input type="search" name="q" value="@Model.Q" class="form-control"
               placeholder="@L["Search by name, phone or plate number"]" aria-label="@L["Search by name, phone or plate number"]" />
        <button type="submit" class="btn btn-outline-secondary">@L["Search"]</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-page="Index">@L["Clear"]</a>
        }
    </div>
</form>

@if (Model.Customers.Count == 0)
{
    <div class="card"><div class="card-body p-4 text-center text-secondary">
        @if (searching)
        {
            <p class="mb-0">@L["No customers match your search."]</p>
        }
        else
        {
            <p>@L["No customers yet. Add your first customer to get started."]</p>
            <a class="btn btn-primary" asp-page="Create">@L["Add customer"]</a>
        }
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@L["Name"]</th>
                        <th scope="col">@L["Phone"]</th>
                        <th scope="col">@L["Vehicles"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td><a class="fw-semibold" asp-page="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                        <td><span class="ltr">@customer.Phone</span></td>
                        <td>
                            @foreach (var vehicle in customer.Vehicles)
                            {
                                var matched = Model.PlateKey.Length > 0 && vehicle.PlateKey.Contains(Model.PlateKey);
                                <a class="plate @(matched ? "plate-match" : "")" dir="auto"
                                   asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Plate</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.HasMore)
    {
        <p class="text-secondary small mt-3">@L["Showing the first {0} customers. Use the search to narrow the list.", IndexModel.PageSize]</p>
    }
}
