@page
@model GarageDesk.Web.Pages.Estimates.CreateModel
@{
    ViewData["Title"] = L["New estimate"].Value;
}

<div class="card shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-4">@L["New estimate"]</h1>

        @if (Model.VehicleOptions.Count == 0)
        {
            <p class="text-secondary">@L["An estimate is made for a vehicle. Add a vehicle first."]</p>
            <a class="btn btn-primary" asp-page="/Vehicles/Create">@L["Add vehicle"]</a>
        }
        else
        {
            <form method="post" novalidate>
                <partial name="_FormErrors" />
                <div class="mb-3">
                    <label asp-for="Input.VehicleId" class="form-label"></label>
                    <select asp-for="Input.VehicleId" asp-items="Model.VehicleOptions" class="form-select">
                        <option value="0">@L["Choose the vehicle."]</option>
                    </select>
                    <span asp-validation-for="Input.VehicleId"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ValidUntil" type="date" class="form-control" placeholder="@L["Valid until"]" />
                    <label asp-for="Input.ValidUntil"></label>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.DiscountAmount" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Discount (EGP)"]" />
                            <label asp-for="Input.DiscountAmount"></label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="@L["Discount (%)"]" />
                            <label asp-for="Input.DiscountPercent"></label>
                            <span asp-validation-for="Input.DiscountPercent"></span>
                        </div>
                    </div>
                </div>
                <div class="form-floating mb-4">
                    <textarea asp-for="Input.Notes" class="form-control" placeholder="@L["Notes"]" style="height: 7rem"></textarea>
                    <label asp-for="Input.Notes"></label>
                    <span asp-validation-for="Input.Notes"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Create estimate"]</button>
                    <a class="btn btn-outline-secondary" asp-page="Index">@L["Cancel"]</a>
                </div>
            </form>
        }
    </div>
</div>
