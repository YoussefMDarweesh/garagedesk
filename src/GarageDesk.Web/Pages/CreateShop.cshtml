@page
@model CreateShopModel
@{
    ViewData["Title"] = "Create your shop";
}

<div class="card shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
        <p class="eyebrow mb-1">Step 2 of 2</p>
        <h1 class="h3 fw-bold">Create your shop</h1>
        <p class="text-secondary mb-4">Last step before you can start. Prices are in EGP.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" placeholder="Shop name" autocomplete="organization" />
                <label asp-for="Input.Name"></label>
                <span asp-validation-for="Input.Name"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Phone" class="form-control" placeholder="Phone" autocomplete="tel" />
                <label asp-for="Input.Phone"></label>
                <span asp-validation-for="Input.Phone"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.Address" class="form-control" placeholder="Address" autocomplete="street-address" />
                <label asp-for="Input.Address"></label>
                <span asp-validation-for="Input.Address"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Create shop</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
