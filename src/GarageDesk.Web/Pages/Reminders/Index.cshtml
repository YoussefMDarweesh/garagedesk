@page
@model IndexModel
@{
    ViewData["Title"] = L["Reminders"].Value;
    var returnUrl = Url.Page("/Reminders/Index", new { show = Model.Show });
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h2 fw-bold mb-0">@L["Reminders"]</h1>
    <a class="btn btn-primary" asp-page="Create">@L["Add reminder"]</a>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(Model.Filter == "open" ? "active" : "")" asp-page="Index">@L["Open"]</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Filter == "done" ? "active" : "")" asp-page="Index" asp-route-show="done">@L["Done"]</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Filter == "all" ? "active" : "")" asp-page="Index" asp-route-show="all">@L["All"]</a></li>
</ul>

@if (Model.Reminders.Count == 0)
{
    <div class="card"><div class="card-body p-4 text-center text-secondary">
        <p class="mb-0">@(Model.Filter == "done"
            ? L["No completed reminders yet."]
            : L["No reminders yet. Add one from here or from a vehicle's page."])</p>
    </div></div>
}
else
{
    <div class="card">
        <ul class="list-group list-group-flush">
            @foreach (var reminder in Model.Reminders)
            {
                <partial name="_ReminderRow" model="new GarageDesk.Web.Pages.Reminders.ReminderRowModel(reminder, Model.Today, returnUrl!, Model.ShopName)" />
            }
        </ul>
    </div>
}
