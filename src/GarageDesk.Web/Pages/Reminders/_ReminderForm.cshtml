@* The fields shared by the Add and Edit reminder pages. *@
@model ReminderFormPageModel

<partial name="_FormErrors" />

<div class="form-section">
    <p class="form-section-title">@L["Vehicle"]</p>
    @if (Model.Vehicle is { } vehicle)
    {
        <input type="hidden" asp-for="Input.VehicleId" />
        <div class="d-flex align-items-center gap-2 p-3 rounded-3 border">
            <span class="plate">@PlateFormat.Html(vehicle.Plate)</span>
            <span>@vehicle.Make @vehicle.Model</span>
            <span class="text-secondary ms-auto">@vehicle.Customer?.Name</span>
        </div>
    }
    else
    {
        <label asp-for="Input.VehicleId" class="form-label fw-semibold"></label>
        <select asp-for="Input.VehicleId" asp-items="Model.VehicleOptions" class="form-select">
            <option value="0">@L["Choose the vehicle."]</option>
        </select>
        <span asp-validation-for="Input.VehicleId"></span>
    }
</div>

<div class="form-section">
    <p class="form-section-title">@L["What needs doing"]</p>
    <div class="form-floating">
        <input asp-for="Input.Type" class="form-control" placeholder="@L["What is due"]" list="reminder-types" autocomplete="off" />
        <label asp-for="Input.Type"></label>
        <span asp-validation-for="Input.Type"></span>
    </div>

    <datalist id="reminder-types">
        <option value="@L["Oil change"]"></option>
        <option value="@L["Brake inspection"]"></option>
        <option value="@L["Tire rotation"]"></option>
        <option value="@L["Annual inspection"]"></option>
        <option value="@L["Battery check"]"></option>
        <option value="@L["Timing belt"]"></option>
    </datalist>
</div>

<div class="form-section mb-4">
    <p class="form-section-title">@L["When it is due"]</p>
    <div class="row g-3 mb-1">
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.DueDate" type="date" class="form-control" placeholder="@L["Due date"]" />
                <label asp-for="Input.DueDate"></label>
            </div>
            <span asp-validation-for="Input.DueDate"></span>
        </div>
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.DueMileage" type="number" inputmode="numeric" class="form-control" placeholder="@L["Due at mileage (km)"]" />
                <label asp-for="Input.DueMileage"></label>
            </div>
            <span asp-validation-for="Input.DueMileage"></span>
        </div>
    </div>
    <p class="form-text mb-0">@L["Fill in a date, a mileage, or both. Whichever comes first makes it due."]</p>
</div>
