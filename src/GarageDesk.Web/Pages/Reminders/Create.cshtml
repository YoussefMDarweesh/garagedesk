@page
@model CreateModel
@{
    ViewData["Title"] = L["Add reminder"].Value;
}

<div class="card shadow-sm auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold mb-4">@L["Add reminder"]</h1>

        @if (Model.Vehicle is null && Model.VehicleOptions.Count == 0)
        {
            <p class="text-secondary">@L["A reminder is for a vehicle. Add a vehicle first."]</p>
            <a class="btn btn-primary" asp-page="/Vehicles/Create">@L["Add vehicle"]</a>
        }
        else
        {
            <form method="post" novalidate>
                <partial name="_ReminderForm" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Save"]</button>
                    <a class="btn btn-outline-secondary" asp-page="Index">@L["Cancel"]</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
