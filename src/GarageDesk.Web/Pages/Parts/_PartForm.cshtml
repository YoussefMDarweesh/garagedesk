@* The fields shared by the Add and Edit part pages. Owner only: it carries the cost price. *@
@model GarageDesk.Web.Pages.Parts.PartFormPageModel

<partial name="_FormErrors" />

<div class="form-section">
    <p class="form-section-title">@L["Part"]</p>
    <div class="form-floating mb-3">
        <input asp-for="Input.Name" class="form-control" placeholder="@L["Name"]" autocomplete="off" />
        <label asp-for="Input.Name"></label>
        <span asp-validation-for="Input.Name"></span>
    </div>
    <div class="row g-3">
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.Sku" class="form-control ltr-input" placeholder="@L["SKU (optional)"]" autocomplete="off" />
                <label asp-for="Input.Sku"></label>
                <span asp-validation-for="Input.Sku"></span>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.Unit" class="form-control" placeholder="@L["Unit"]" autocomplete="off" />
                <label asp-for="Input.Unit"></label>
                <span asp-validation-for="Input.Unit"></span>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <p class="form-section-title">@L["Prices"]</p>
    <div class="row g-3">
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.CostPrice" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Cost price (EGP)"]" inputmode="decimal" />
                <label asp-for="Input.CostPrice"></label>
                <span asp-validation-for="Input.CostPrice"></span>
            </div>
            <p class="form-text mb-0">@L["What you pay your supplier. Only the owner sees it."]</p>
        </div>
        <div class="col-sm-6">
            <div class="form-floating">
                <input asp-for="Input.SellPrice" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Sell price (EGP)"]" inputmode="decimal" />
                <label asp-for="Input.SellPrice"></label>
                <span asp-validation-for="Input.SellPrice"></span>
            </div>
            <p class="form-text mb-0">@L["What the customer is charged. It is filled in when the part is picked on a job card."]</p>
        </div>
    </div>
</div>

<div class="form-section mb-4">
    <p class="form-section-title">@L["Stock"]</p>
    <div class="row g-3">
        @if (Model.IsNew)
        {
            <div class="col-sm-4">
                <div class="form-floating">
                    <input asp-for="Input.OpeningQuantity" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Quantity on hand"]" inputmode="decimal" />
                    <label asp-for="Input.OpeningQuantity"></label>
                    <span asp-validation-for="Input.OpeningQuantity"></span>
                </div>
            </div>
        }
        <div class="col-sm-4">
            <div class="form-floating">
                <input asp-for="Input.LowStockThreshold" type="number" step="0.01" min="0" class="form-control" placeholder="@L["Low-stock alert at"]" inputmode="decimal" />
                <label asp-for="Input.LowStockThreshold"></label>
                <span asp-validation-for="Input.LowStockThreshold"></span>
            </div>
            <p class="form-text mb-0">@L["Leave empty for no alert."]</p>
        </div>
        <div class="col-sm-4">
            <div class="form-floating">
                <input asp-for="Input.Supplier" class="form-control" placeholder="@L["Supplier (optional)"]" autocomplete="off" />
                <label asp-for="Input.Supplier"></label>
                <span asp-validation-for="Input.Supplier"></span>
            </div>
        </div>
    </div>
</div>
